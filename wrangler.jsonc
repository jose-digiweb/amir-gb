// Cloudflare Workers config (free plan). Bindings follow EmDash's Cloudflare guide:
// https://docs.emdashcms.com/deployment/cloudflare/
// The project is named amir-gb: the Worker, its D1 database (amir-gb) and its R2 bucket
// (amir-gb-media). Nothing exists on Cloudflare yet; the first deploy creates them.
// Local dev needs no IDs: Wrangler simulates D1 and R2 in .wrangler/.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amir-gb",
  // The Jose Digiweb Cloudflare account, so a deploy can never land in another account the login reaches.
  "account_id": "199b6cc24673b9eeccbff632eefdafd7",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Variables set in the Cloudflare dashboard (SITE_URL) survive deploys that do not list them.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },

  // EmDash content database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amir-gb",
      // Created in the EU jurisdiction: the data stays inside the EU.
      "database_id": "d775227d-7ef5-4f62-a08a-9d37e8307d00",
    },
  ],
  // EmDash media library.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "amir-gb-media",
      // Created in the EU jurisdiction, like the database.
      "jurisdiction": "eu",
    },
  ],
  // EmDash co-editing rooms.
  "durable_objects": {
    "bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }],
  },
  "exports": {
    "EmDashRoom": { "type": "durable-object", "storage": "sqlite" },
  },
  // Scheduled publishing and EmDash maintenance.
  "triggers": { "crons": ["* * * * *"] },
}

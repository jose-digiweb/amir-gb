{
  "name": "amir-gb",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && vue-tsc --noEmit -p tsconfig.vue.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "verify": "oxfmt --check && oxlint && astro check && vue-tsc --noEmit -p tsconfig.vue.json && vitest run && astro build",
    "types": "wrangler types",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/react": "^7.1.8",
    "@astrojs/vue": "^7.1.5",
    "@emdash-cms/cloudflare": "^1.5.0",
    "@lucide/astro": "^1.72.0",
    "@lucide/vue": "^1.72.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.11",
    "emdash": "^1.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.37.0",
    "stripe": "^23.0.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.161.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.23.4"
  }
}

---
// Dependencies
import { ArrowRight } from "@lucide/astro";
import { Image } from "emdash/ui";
import { INTL_LOCALE } from "../../../i18n/constants";
import { getLocale, getTranslations } from "../../../i18n/helpers";
import { getStoryLabel } from "./helpers";

// Components
import DutchOnlyMark from "../../site/DutchOnlyMark.astro";

// Types
import type { HomeStory } from "../../../lib/content/types";

/**
 * The {@link Props} type
 * @description The props of the OneStoryCard component, the only story on phone: one wide photo card with STORY and its date, the title and Read the story
 */
type Props = {
  /** The story. */
  story: HomeStory;
};

// Read the story and write its label in the page's language
const { story } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = getTranslations(locale);
const label = getStoryLabel(t["stories.label"], story.publishedAt, INTL_LOCALE[locale]);
---

<a
  href={story.href}
  class="relative isolate flex h-75 touch-manipulation flex-col justify-end gap-1.5 overflow-hidden rounded-lg bg-surface-sunken p-4 text-on-brand transition-[scale] duration-fast ease-standard select-none active:scale-98"
>
  <Image
    image={story.image}
    alt=""
    sizes="100vw"
    loading="lazy"
    class="absolute inset-0 -z-10 size-full object-cover"
  />
  <span aria-hidden="true" class="one-story-fade absolute inset-0 -z-10"></span>
  <span class="type-label text-on-brand-muted uppercase">{label}</span>
  <h3 class="type-h2 text-balance hyphens-auto">
    {story.title}
    {story.isDutchOnly ? <DutchOnlyMark /> : null}
  </h3>
  <span class="flex items-center gap-1.5 type-button">
    {t["stories.read"]}
    <ArrowRight class="size-icon-md" />
  </span>
</a>

<style>
  @reference "../../../styles/global.css";

  .one-story-fade {
    background: linear-gradient(to top, var(--surface-inverse) 0%, transparent 64%);
  }
</style>

---
// Dependencies
import { getLocale, getTranslations } from "../../i18n/helpers";

// Components
import SiteLayout from "../../layouts/SiteLayout.astro";
import AnnouncementStrip from "./AnnouncementStrip.astro";
import WhatsOnSection from "./events/WhatsOnSection.astro";
import HelpSection from "./help/HelpSection.astro";
import OpeningSection from "./opening/OpeningSection.astro";
import LifeSection from "./stories/LifeSection.astro";
import SupportSection from "./support/SupportSection.astro";
import TogetherSection from "./together/TogetherSection.astro";
import WovenDefs from "./WovenDefs.astro";

// Types
import type { HomeContent } from "../../lib/content/types";
import type { SupportState } from "../../lib/donate/types";

/**
 * The {@link Props} type
 * @description The props of the HomePage component, the home page in the page's language
 */
type Props = {
  /** Everything the page shows from EmDash, read by the page route before rendering starts. */
  content: HomeContent;
  /** What Support AMIR-GB shows: the form, or the result of a gift, read by the page route. */
  support: SupportState;
};

// Read the content and the page's copy
const { content, support } = Astro.props;
const t = getTranslations(getLocale(Astro.currentLocale));
const hasStories = content.stories.length > 0;
---

<SiteLayout title={t["home.title"]} description={t["home.description"]}>
  {content.announcement ? (
    <AnnouncementStrip slot="announcement" announcement={content.announcement} />
  ) : null}
  <WovenDefs />
  <OpeningSection />
  <HelpSection />
  <TogetherSection />
  <WhatsOnSection events={content.events} activities={content.activities} />
  {hasStories ? <LifeSection stories={content.stories} /> : null}
  <SupportSection support={support} />
</SiteLayout>

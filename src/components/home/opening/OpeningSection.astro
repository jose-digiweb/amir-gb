---
// Dependencies
import { ArrowRight, MessageCircle } from "@lucide/astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLocale, getTranslations } from "../../../i18n/helpers";
import { CONTACT, ROUTE } from "../../../site/constants";
import { BUTTON_SIZE, BUTTON_TONE } from "../../ui/constants";
import {
  DESKTOP_CONSTELLATION,
  OPENING_OPENER_LANGS,
  PHONE_CONSTELLATION,
  TABLET_CONSTELLATION,
} from "./constants";

// Components
import WhatsAppHelpLink from "../../site/WhatsAppHelpLink.astro";
import Button from "../../ui/Button.astro";
import Opener from "../../ui/Opener.astro";
import OpenerDots from "../OpenerDots.astro";
import Constellation from "./Constellation.astro";

/**
 * The {@link Props} type
 * @description The props of the OpeningSection component: the greeting, the title, Join AMIR-GB and the woven constellation
 */
type Props = Record<string, never>;

// Prepare the copy and the join link in the page's language
const locale = getLocale(Astro.currentLocale);
const t = getTranslations(locale);
const joinHref = getRelativeLocaleUrl(locale, ROUTE.JOIN);
---

<section
  aria-labelledby="opening-title"
  data-home-opening
  class="opening relative isolate -mt-16 flex min-h-svh flex-col overflow-hidden bg-bg-alt pt-16 text-text-heading tablet:block tablet:pt-0 desktop:-mt-20"
>
  <div class="relative min-h-50 flex-1 tablet:hidden">
    <Constellation
      layout={PHONE_CONSTELLATION}
      id="opening-phone"
      class="absolute inset-0 size-full"
    />
  </div>
  <Constellation
    layout={TABLET_CONSTELLATION}
    id="opening-tablet"
    class="absolute top-0 right-0 -z-10 hidden h-full w-auto tablet:block desktop:hidden"
  />
  <Constellation
    layout={DESKTOP_CONSTELLATION}
    id="opening-desktop"
    class="absolute top-1/2 right-0 -z-10 hidden h-auto max-h-full w-auto -translate-y-1/2 desktop:block"
  />

  <div class="flex flex-col gap-3 px-margin pt-2 pb-16 tablet:w-xl tablet:gap-6 tablet:pt-0 tablet:pt-36 tablet:pb-24 tablet:pl-margin-md desktop:absolute desktop:top-1/2 desktop:left-margin-lg desktop:w-xl desktop:-translate-y-1/2 desktop:gap-8 desktop:p-0">
    <div class="relative flex flex-col gap-3 tablet:gap-4">
      <OpenerDots id="opener-dots-opening" />
      <Opener label={t["opening.opener"]} langs={OPENING_OPENER_LANGS} />
      <h1 id="opening-title" class="type-hero text-balance">
        {t["opening.title"]}
      </h1>
    </div>
    <p class="type-body text-pretty text-text tablet:max-w-sm desktop:max-w-md desktop:type-lead">
      {t["opening.text"]}
    </p>
    <div class="mt-3 flex flex-col gap-3 tablet:mt-0 tablet:items-start tablet:gap-2 desktop:flex-row desktop:items-center desktop:gap-8">
      <Button href={joinHref} block class="tablet:w-auto">
        {t["opening.join"]}
        <ArrowRight />
      </Button>
      <Button
        href={CONTACT.WHATSAPP_HREF}
        tone={BUTTON_TONE.OUTLINE}
        size={BUTTON_SIZE.COMPACT}
        block
        class="tablet:hidden"
      >
        <MessageCircle />
        {t["contact.whatsappHelp"]}
      </Button>
      <div class="hidden tablet:block">
        <WhatsAppHelpLink />
      </div>
    </div>
  </div>
</section>

<style>
  @reference "../../../styles/global.css";

  .opening {
    @variant desktop {
      height: calc(100svh - var(--space-8));
    }
  }
</style>

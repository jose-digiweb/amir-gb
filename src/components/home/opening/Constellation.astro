---
// Dependencies
import { getLocale, getTranslations } from "../../../i18n/helpers";
import { getValueChips } from "../../../site/helpers";
import { CONSTELLATION_PHOTO_SIZES } from "./constants";

// Components
import BeadRing from "../../opening/BeadRing.astro";
import CentreDisc from "../../opening/CentreDisc.astro";
import JoinedHands from "../../opening/JoinedHands.astro";
import OpeningDrawing from "../../opening/OpeningDrawing.astro";
import Sparkles from "../../opening/Sparkles.astro";
import StarChip from "../../opening/StarChip.astro";
import StitchedThread from "../../opening/StitchedThread.astro";
import ConstellationDisc from "./ConstellationDisc.astro";

// Types
import type { ConstellationLayout } from "./types";

/**
 * The {@link Props} type
 * @description The props of the Constellation component, the joined hands in a ring of beads with the services and values round them
 */
type Props = {
  /** The screen size's drawing. */
  layout: ConstellationLayout;
  /** A prefix for the drawing's own pattern ids, unique on the page. */
  id: string;
  /** Size and placement classes from the caller. */
  class?: string;
};

// Read the drawing, name its threads and its values in the page's language
const { layout, id, class: className } = Astro.props;
const t = getTranslations(getLocale(Astro.currentLocale));
const threads = layout.threads.paths.map((path, index) => ({ path, id: `${id}-thread-${index}` }));
const pills = getValueChips(layout.pills, t);
---

<OpeningDrawing frame={layout.frame} dots={layout.dots} id={id} class={className}>
  <BeadRing ring={layout.ring}>
    {threads.map((thread, index) => (
      <StitchedThread
        path={thread.path}
        stitch={layout.threads.stitch}
        frame={layout.frame}
        id={thread.id}
        order={index}
      />
    ))}
  </BeadRing>
  <Sparkles sparkles={layout.lozenges} />
  <CentreDisc disc={layout.photo}>
    <JoinedHands sizes={CONSTELLATION_PHOTO_SIZES} />
  </CentreDisc>
  {layout.discs.map((disc) => (
    <ConstellationDisc disc={disc} hasLabel={layout.hasLabels} />
  ))}
  {pills.map((pill) => (
    <StarChip x={pill.x} y={pill.y} label={pill.label} />
  ))}
</OpeningDrawing>

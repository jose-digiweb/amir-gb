---
// Dependencies
import { ArrowRight } from "@lucide/astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLocale, getTranslations } from "../../../i18n/helpers";
import { ROUTE } from "../../../site/constants";

// Components
import Button from "../../ui/Button.astro";
import Opener from "../../ui/Opener.astro";
import WovenShade from "../../ui/WovenShade.astro";
import Cloth from "./Cloth.astro";
import MembersLabel from "./MembersLabel.astro";
import MottoChips from "./MottoChips.astro";

/**
 * The {@link Props} type
 * @description The props of the TogetherSection component: Stronger together, the motto, the members label and the cloth
 */
type Props = Record<string, never>;

// Prepare the copy and the join link in the page's language
const locale = getLocale(Astro.currentLocale);
const t = getTranslations(locale);
const joinHref = getRelativeLocaleUrl(locale, ROUTE.JOIN);
---

<section
  aria-labelledby="together-title"
  class="relative isolate z-10 overflow-hidden rounded-t-xl bg-bg-alt px-margin pt-12 pb-36 tablet:px-margin-md tablet:pt-18 tablet:pb-44 desktop:px-margin-lg desktop:pt-24 desktop:pb-64"
>
  <WovenShade />
  <div class="flex flex-col tablet:flex-row tablet:items-center tablet:justify-between tablet:gap-6 desktop:gap-12">
    <div class="flex flex-col tablet:w-81 desktop:w-132 desktop:shrink-0">
      <Opener label={t["together.opener"]} />
      <h2 id="together-title" class="mt-2 type-section-title text-text-heading desktop:mt-3">
        <span class="whitespace-nowrap tablet:block desktop:inline">
          {t["together.titleStart"]}
        </span>{" "}
        <span class="whitespace-nowrap">{t["together.titleEnd"]}</span>
      </h2>
      <p class="mt-4 type-body text-pretty text-text-muted desktop:mt-6 desktop:max-w-120 desktop:type-lead">
        {t["together.text"]}
      </p>
      <div class="mt-5 desktop:mt-7">
        <MottoChips />
      </div>
      <MembersLabel class="mt-7 hidden tablet:flex desktop:hidden">
        <Button href={joinHref} class="relative z-20 w-full">
          {t["opening.join"]}
          <ArrowRight />
        </Button>
      </MembersLabel>
      <div class="mt-10 hidden desktop:flex">
        <Button href={joinHref}>
          {t["opening.join"]}
          <ArrowRight />
        </Button>
      </div>
    </div>
    <div class="relative mt-10 tablet:mt-0 tablet:w-102 tablet:shrink-0 desktop:w-auto desktop:max-w-174 desktop:min-w-0 desktop:flex-1">
      <Cloth />
      <MembersLabel class="absolute -bottom-11 left-3 z-20 -rotate-3 tablet:hidden" />
    </div>
  </div>
  <Button href={joinHref} block class="mt-17 tablet:hidden">
    {t["opening.join"]}
    <ArrowRight />
  </Button>
</section>

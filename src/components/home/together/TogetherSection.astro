---
// Dependencies
import { ArrowRight } from "@lucide/astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLocale, getTranslations } from "../../../i18n/helpers";
import { ROUTE } from "../../../site/constants";

// Components
import Button from "../../ui/Button.astro";
import MottoChips from "../../site/MottoChips.astro";
import Opener from "../../ui/Opener.astro";
import OpenerDots from "../OpenerDots.astro";
import WovenShade from "../../ui/WovenShade.astro";
import Cloth from "./Cloth.astro";

/**
 * The {@link Props} type
 * @description The props of the TogetherSection component: Stronger together, the motto, the join button and the cloth
 */
type Props = Record<string, never>;

// Prepare the copy and the join link in the page's language
const locale = getLocale(Astro.currentLocale);
const t = getTranslations(locale);
const joinHref = getRelativeLocaleUrl(locale, ROUTE.JOIN);
---

<section
  aria-labelledby="together-title"
  class="relative isolate z-10 -mt-8 overflow-hidden rounded-t-xl bg-bg-alt px-margin pt-10 pb-20 tablet:mt-0 tablet:px-margin-md tablet:pt-18 tablet:pb-44 desktop:px-margin-lg desktop:pt-24 desktop:pb-64"
>
  <WovenShade />
  <div class="flex flex-col tablet:flex-row tablet:items-center tablet:justify-between tablet:gap-6 desktop:gap-12">
    <div class="contents tablet:flex tablet:w-81 tablet:flex-col desktop:w-132 desktop:shrink-0">
      <div class="relative flex flex-col">
        <OpenerDots id="opener-dots-together" />
        <Opener label={t["together.opener"]} />
        <h2 id="together-title" class="mt-2 type-section-title text-text-heading desktop:mt-3">
          <span class="whitespace-nowrap tablet:block desktop:inline">
            {t["together.titleStart"]}
          </span>{" "}
          <span class="whitespace-nowrap">{t["together.titleEnd"]}</span>
        </h2>
      </div>
      <p class="order-2 mt-5 type-body text-pretty text-text-muted tablet:order-none tablet:mt-4 desktop:mt-6 desktop:max-w-120 desktop:type-lead">
        {t["together.text"]}
      </p>
      <div class="order-3 mt-5 tablet:order-none desktop:mt-7">
        <MottoChips />
      </div>
      <div class="mt-8 hidden tablet:flex desktop:mt-10">
        <Button href={joinHref}>
          {t["opening.join"]}
          <ArrowRight />
        </Button>
      </div>
    </div>
    <div class="relative order-1 mt-6 tablet:order-none tablet:mt-0 tablet:w-102 tablet:shrink-0 desktop:w-auto desktop:max-w-174 desktop:min-w-0 desktop:flex-1">
      <Cloth />
    </div>
  </div>
  <Button href={joinHref} block class="mt-6 tablet:hidden">
    {t["opening.join"]}
    <ArrowRight />
  </Button>
</section>

---
// Dependencies
import { Picture } from "astro:assets";

// Components
import ClothFringe from "./ClothFringe.astro";

// Types
import type { ImageMetadata } from "astro";

/**
 * The {@link Props} type
 * @description The props of the ClothPhoto component, one photo strip of the cloth with its fringe
 */
type Props = {
  /** The photo. */
  src: ImageMetadata;
  /** What the photo shows. */
  alt: string;
  /** A unique id for the fringe pattern. */
  id: string;
  /** Order, height and width classes from the caller. */
  class?: string;
  /** Where the photo is cropped from. */
  focus?: string;
};

// Read the photo, its description and its place in the cloth
const { src, alt, id, class: className, focus } = Astro.props;
---

<div class:list={["relative basis-0", className]}>
  <Picture
    src={src}
    alt={alt}
    widths={[186, 372]}
    sizes="186px"
    class:list={["size-full rounded-t-lg object-cover", focus]}
  />
  <ClothFringe id={id} />
</div>

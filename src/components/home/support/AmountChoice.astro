---
/**
 * The {@link Props} type
 * @description The props of the AmountChoice component, one preset amount of the donation form
 */
type Props = {
  /** The amount in euros. */
  amount: number;
  /** The amount as the page's language writes it. */
  label: string;
  /** Picked before the visitor chooses. */
  isPicked?: boolean;
};

// Read the amount and how it reads
const { amount, label, isPicked = false } = Astro.props;
---

<label class="relative flex">
  <input type="radio" name="amount" value={amount} checked={isPicked} class="peer sr-only" />
  <span class="amount grid h-16 flex-1 cursor-pointer place-items-center rounded-md type-h2 font-extrabold text-text-heading transition-colors duration-base select-none peer-checked:bg-selected peer-checked:text-on-selected hover:bg-hover-quiet">
    {label}
  </span>
</label>

<style>
  @reference "../../../styles/global.css";

  .amount {
    box-shadow: inset 0 0 0 var(--border-width-control) var(--border-control);
  }

  :checked + .amount {
    box-shadow: inset 0 0 0 calc(var(--border-width-control) + var(--border-width))
      var(--border-strong);
  }
</style>

---
// Dependencies
import { Check } from "@lucide/astro";
import { getLocale, getTranslations } from "../../../i18n/helpers";
import { fillAmount, formatAmount } from "../../../lib/donate/helpers";
import { RETURN_TONE } from "./constants";

// Components
import GiftShareLink from "./GiftShareLink.astro";
import GiveAgainLink from "./GiveAgainLink.astro";
import ReturnCard from "./ReturnCard.astro";

/**
 * The {@link Props} type
 * @description The props of the GiftThanks component, the thank you after a one-off gift was paid
 */
type Props = {
  /** The gift in cents, as Stripe charged it. */
  amountCents: number;
};

// Write the sentence with the amount in the page's language
const { amountCents } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = getTranslations(locale);
const text = fillAmount(t["gift.paidText"], formatAmount(locale, amountCents));
---

<ReturnCard
  tone={RETURN_TONE.SUCCESS}
  opener={t["gift.thanksOpener"]}
  title={t["gift.thanksTitle"]}
  text={text}
>
  <Check slot="mark" />
  <GiftShareLink />
  <GiveAgainLink />
</ReturnCard>

---
// Dependencies
import { getLocale, getTranslations } from "../../../i18n/helpers";
import { DESKTOP_SUPPORT_HANDS, PHONE_SUPPORT_CROWN, TABLET_SUPPORT_HANDS } from "./constants";

// Components
import DonationWidget from "../../support/DonationWidget.astro";
import Opener from "../../ui/Opener.astro";
import WovenShade from "../../ui/WovenShade.astro";
import OpenerDots from "../OpenerDots.astro";
import SupportCrown from "./SupportCrown.astro";
import SupportHands from "./SupportHands.astro";

// Types
import type { SupportState } from "../../../lib/donate/types";

/**
 * The {@link Props} type
 * @description The props of the SupportSection component: Support AMIR-GB, the words and the joined hands as one group beside one calm donation form, or the result of a gift in its place
 */
type Props = {
  /** The form, or the result of a return from Stripe, read by the page route. */
  support: SupportState;
};

// Read the state and the copy
const { support } = Astro.props;
const t = getTranslations(getLocale(Astro.currentLocale));
---

<section
  id="support"
  aria-labelledby="support-title"
  data-overlaps-footer
  class="support relative isolate z-20 mx-3 overflow-hidden rounded-xl bg-bg-alt text-text tablet:z-10 tablet:mx-6 desktop:mx-margin-lg"
>
  <WovenShade />
  <div class="support-group mx-auto flex flex-col px-4 pt-9 pb-24 tablet:grid tablet:max-w-196.5 tablet:items-start tablet:gap-x-4 tablet:px-margin-md tablet:pt-13 tablet:pb-10 desktop:max-w-324 desktop:gap-x-24 desktop:px-margin-lg desktop:pt-26">
    <div class="relative flex min-w-0 flex-col px-2 tablet:col-start-1 tablet:row-start-1 tablet:px-0 desktop:max-w-130">
      <OpenerDots id="opener-dots-support" />
      <Opener label={t["support.opener"]} />
      <h2
        id="support-title"
        class="mt-2.5 type-section-title text-text-heading tablet:mt-4 desktop:mt-5"
      >
        <span class="whitespace-nowrap tablet:block desktop:inline">{t["support.titleStart"]}</span>{" "}
        <span class="whitespace-nowrap">{t["support.titleEnd"]}</span>
      </h2>
      <p class="mt-2.5 type-body text-pretty tablet:mt-3.5 desktop:mt-4.5 desktop:max-w-110 desktop:type-lead">
        {t["support.text"]}
      </p>
    </div>
    <SupportHands
      layout={TABLET_SUPPORT_HANDS}
      id="support-tablet"
      class="support-tablet relative -z-10 hidden h-auto justify-self-end tablet:col-start-1 tablet:row-start-2 tablet:block desktop:hidden"
    />
    <SupportHands
      layout={DESKTOP_SUPPORT_HANDS}
      id="support-desktop"
      class="support-desktop relative -z-10 hidden h-auto justify-self-end desktop:col-start-1 desktop:row-start-2 desktop:block"
    />
    <div class="relative mt-19 tablet:col-start-2 tablet:row-span-2 tablet:row-start-1 tablet:mt-3 desktop:mt-9">
      <SupportCrown
        layout={PHONE_SUPPORT_CROWN}
        id="support-phone"
        class="absolute -top-32.5 left-1/2 -z-10 -translate-x-1/2 tablet:hidden"
      />
      <DonationWidget support={support} />
    </div>
  </div>
</section>

<style>
  @reference "../../../styles/global.css";

  /* Without Life at AMIR between them, Support keeps its distance from the navy band */
  :global(#events) + .support {
    margin-top: var(--space-16);

    @variant tablet {
      margin-top: var(--space-20);
    }

    @variant desktop {
      margin-top: var(--space-24);
    }
  }

  .support {
    margin-top: calc(var(--space-8) * -1);
    margin-bottom: calc(var(--space-24) * -1);

    @variant tablet {
      margin-top: 0;
      min-height: calc(var(--space-32) * 5 + var(--space-20));
      margin-bottom: calc(var(--space-24) * -1 - var(--space-4));
    }

    @variant desktop {
      min-height: calc(var(--space-32) * 6 + var(--space-16) + var(--space-2));
      margin-bottom: calc(var(--space-32) * -1 - var(--space-6));
    }
  }

  /* The words take the left column with the drawing under them, the widget the right; the board's 330 and 360 on tablet */
  .support-group {
    @variant tablet {
      grid-template-columns: minmax(0, 11fr) minmax(0, 12fr);
      grid-template-rows: auto 1fr;
    }

    @variant desktop {
      container-type: inline-size;
      grid-template-columns: minmax(0, 1fr) calc(var(--spacing) * 115);
    }
  }

  /* The tablet drawing spans the words column and the gap, so its thread reaches the widget */
  .support :global(.support-tablet) {
    width: calc(100% + var(--space-4));
    margin-right: calc(var(--space-4) * -1);
  }

  /* The desktop drawing hangs from the widget's left edge across the gap, which keeps its thread clear of the words, and narrows below 1440 */
  .support :global(.support-desktop) {
    width: min(calc(var(--spacing) * 151), 53.2cqw);
    margin-right: calc(var(--space-24) * -1);
  }
</style>

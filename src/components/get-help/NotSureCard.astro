---
// Dependencies
import { MessageCircle, MessageCircleQuestionMark } from "@lucide/astro";
import { getLocale, getTranslations } from "../../i18n/helpers";
import { CONTACT } from "../../site/constants";
import { BUTTON_SIZE } from "../ui/constants";

// Components
import Button from "../ui/Button.astro";
import DecorBead from "../ui/DecorBead.astro";

/**
 * The {@link Props} type
 * @description The props of the NotSureCard component, the navy card that ends the help areas on tablet and desktop: Not sure? Ask us
 */
type Props = Record<string, never>;

// Write the card in the page's language
const t = getTranslations(getLocale(Astro.currentLocale));
---

<article class="relative isolate flex flex-col gap-4 overflow-hidden rounded-lg bg-surface-brand p-5 text-on-brand [--focus:var(--focus-on-brand)] desktop:p-6">
  <DecorBead ringed class="top-6 right-6 size-7" />
  <span class="grid size-14 place-items-center rounded-full bg-pressed-quiet-on-brand desktop:size-16">
    <MessageCircleQuestionMark class="size-icon-lg" />
  </span>
  <h3 class="type-h3 text-balance">{t["help.ask"]}</h3>
  <p class="flex-1 type-body-sm text-on-brand-muted">{t["getHelp.notSureText"]}</p>
  <Button href={CONTACT.WHATSAPP_HREF} size={BUTTON_SIZE.COMPACT} class="self-start px-5">
    <MessageCircle />
    {t["contact.whatsapp"]}
  </Button>
</article>

---
// Dependencies
import { getLocale, getTranslations } from "../../i18n/helpers";
import { MOTTO_STACKED_LOCALES, VALUE, VALUE_LABEL } from "../../site/constants";

// Components
import StarMark from "../ui/StarMark.astro";

/**
 * The {@link Props} type
 * @description The props of the MottoChips component, AMIR-GB's motto sewn on as dashed gold labels that never wrap: in pairs where a pair fits, one per row where it does not, two aligned columns from desktop; labels, never controls
 */
type Props = {
  /** Where the motto shows, from the caller. */
  class?: string;
};

// Name every value in the page's language
const { class: className } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = getTranslations(locale);
const isStacked = MOTTO_STACKED_LOCALES.includes(locale);
const values = Object.values(VALUE).map((value) => ({ value, label: t[VALUE_LABEL[value]] }));

// Pair the values into the two rows they keep where a pair fits
const half = values.length / 2;
const rows = [values.slice(0, half), values.slice(half)];
---

<div
  role="list"
  aria-label={t["values.label"]}
  class:list={[
    "flex flex-col items-start gap-2 desktop:grid desktop:grid-cols-[repeat(2,max-content)] desktop:justify-items-start",
    className,
  ]}
>
  {rows.map((row) => (
    <div
      class:list={[
        "flex max-w-full gap-2 desktop:contents",
        { "flex-wrap items-center": !isStacked, "flex-col items-start": isStacked },
      ]}
    >
      {row.map((item) => (
        <span
          role="listitem"
          class="flex min-h-chip items-center gap-2 rounded-pill border-(length:--border-width-stitch) border-dashed border-stitch py-2 pr-3.5 pl-3 type-sewn-label whitespace-nowrap text-text-heading uppercase select-none"
        >
          <StarMark class="size-icon-xs shrink-0 text-accent" />
          {item.label}
        </span>
      ))}
    </div>
  ))}
</div>

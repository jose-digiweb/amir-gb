---
// Dependencies
import { Picture } from "astro:assets";
import { getBeadRing } from "../../lib/woven/helpers";
import { WOVEN_DEFS } from "../ui/constants";
import { SUPPORT_RING } from "./constants";
import joinedHands from "../../assets/photos/joined-hands.jpg";

/**
 * The {@link Props} type
 * @description The props of the JoinedHandsRing component, the joined hands in a circle with a thin gold ring and woven beads round it, beside a donation widget
 */
type Props = {
  /** Which photo width the browser picks at each screen size, as the caller lays the ring out. */
  sizes: string;
  /** Place and size classes from the caller; the ring fills the box it is given. */
  class?: string;
};

// Read the layout and draw the ring of beads
const { sizes, class: className } = Astro.props;
const ring = getBeadRing(SUPPORT_RING);
const solidHref = `#${WOVEN_DEFS.SOLID}`;
const ringedHref = `#${WOVEN_DEFS.RINGED}`;
---

<div aria-hidden="true" class={className}>
  <svg viewBox={SUPPORT_RING.VIEW_BOX} class="absolute inset-0 size-full overflow-visible">
    <circle
      cx={SUPPORT_RING.centreX}
      cy={SUPPORT_RING.centreY}
      r={SUPPORT_RING.radius}
      fill="none"
      stroke-width="1.5"
      vector-effect="non-scaling-stroke"
      class="stroke-accent opacity-60"
    ></circle>
    {ring.solid.map((bead) => (
      <use href={solidHref} transform={bead.transform} />
    ))}
    {ring.ringed.map((bead) => (
      <use href={ringedHref} transform={bead.transform} />
    ))}
  </svg>
  <div class="absolute inset-[7%] overflow-hidden rounded-full shadow-md">
    <Picture
      src={joinedHands}
      alt=""
      widths={[160, 312, 520, 1040]}
      sizes={sizes}
      class="size-full object-cover"
    />
  </div>
</div>

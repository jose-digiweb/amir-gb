---
// Dependencies
import { actions } from "astro:actions";
import { getLocale, getTranslations } from "../../i18n/helpers";
import { GIFT_RETURN, GIFT_STATE } from "../../lib/donate/constants";
import { getDonateFormCopy } from "../../lib/donate/helpers";

// Components
import BankTransfer from "./BankTransfer.astro";
import DonateForm from "./DonateForm.vue";
import GiftFailed from "./GiftFailed.astro";
import GiftProcessing from "./GiftProcessing.astro";
import GiftStopped from "./GiftStopped.astro";
import GiftThanks from "./GiftThanks.astro";
import MonthlyGiftThanks from "./MonthlyGiftThanks.astro";

// Types
import type { HTMLAttributes } from "astro/types";
import type { SupportState } from "../../lib/donate/types";

/**
 * The {@link Props} type
 * @description The props of the DonationWidget component: the calm donation form, or the result of a gift in its place, with the bank transfer bar under it
 */
type Props = Omit<HTMLAttributes<"div">, "class"> & {
  /** The form, or the result of a return from Stripe, read by the page route. */
  support: SupportState;
  /** Place and width classes from the caller. */
  class?: string;
};

// Prepare the form's copy and the action it posts to on this page
const { support, class: className, ...rest } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const formCopy = getDonateFormCopy(getTranslations(locale));
const formAction = `${actions.donate}${GIFT_RETURN.HASH}`;
---

<div class:list={["flex flex-col gap-3.5", className]} {...rest}>
  {support.state === GIFT_STATE.FORM ? (
    <DonateForm
      client:visible
      locale={locale}
      copy={formCopy}
      action={formAction}
      initialError={support.error}
    />
  ) : null}
  {support.state === GIFT_STATE.PAID ? <GiftThanks amountCents={support.amountCents} /> : null}
  {support.state === GIFT_STATE.PAID_MONTHLY ? (
    <MonthlyGiftThanks amountCents={support.amountCents} />
  ) : null}
  {support.state === GIFT_STATE.PROCESSING ? (
    <GiftProcessing amountCents={support.amountCents} />
  ) : null}
  {support.state === GIFT_STATE.STOPPED ? <GiftStopped choice={support.choice} /> : null}
  {support.state === GIFT_STATE.FAILED ? <GiftFailed /> : null}
  <BankTransfer />
</div>

---
// Components
import PromiseIcon from "./PromiseIcon.astro";

// Types
import type { PrivacyPromise } from "./types";

/**
 * The {@link Props} type
 * @description The props of the PromiseCard component, one privacy promise as a white card with its icon, in a list
 */
type Props = {
  /** The promise, which picks the icon. */
  promise: PrivacyPromise;
  /** The promise in a few words. */
  title: string;
  /** What it means, in one or two sentences. */
  text: string;
};

// Read the promise and its copy
const { promise, title, text } = Astro.props;
---

<li class="flex flex-col gap-3 rounded-lg border border-border bg-surface p-5">
  <span class="grid size-12 place-items-center rounded-full bg-tint-navy text-text-heading">
    <PromiseIcon promise={promise} class="size-icon-md" />
  </span>
  <h2 class="type-h3 text-balance text-text-heading">{title}</h2>
  <p class="type-body-sm text-pretty text-text">{text}</p>
</li>

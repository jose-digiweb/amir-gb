---
// Dependencies
import { getLocale, getTranslations } from "../../i18n/helpers";
import { getPrivacyEntry } from "./queries";

// Components
import SiteLayout from "../../layouts/SiteLayout.astro";
import PrivacyOpening from "./PrivacyOpening.astro";
import PrivacyTextSection from "./PrivacyTextSection.astro";

/**
 * The {@link Props} type
 * @description The props of the PrivacyPage component, the privacy page in the page's language
 */
type Props = Record<string, never>;

// Read the page's title and summary, and the text in its language
const locale = getLocale(Astro.currentLocale);
const t = getTranslations(locale);
const entry = await getPrivacyEntry(locale);
---

<SiteLayout title={t["privacy.title"]} description={t["privacy.description"]}>
  <PrivacyOpening updated={entry.data.updated} />
  <PrivacyTextSection entry={entry} />
</SiteLayout>

---
// Dependencies
import logoColour from "../../assets/brand/amir-gb_horizontal-short_colour.svg";
import logoReverse from "../../assets/brand/amir-gb_horizontal-short_reverse.svg";

/**
 * The {@link Props} type
 * @description The props of the CentreLogo component, the AMIR-GB logo in a centre disc: in colour, and the reverse logo in dark
 */
type Props = Record<string, never>;
---

<span class="grid size-full place-items-center">
  <img
    src={logoColour.src}
    width={logoColour.width}
    height={logoColour.height}
    alt=""
    class="h-auto w-7/10 dark:hidden"
  />
  <img
    src={logoReverse.src}
    width={logoReverse.width}
    height={logoReverse.height}
    alt=""
    class="hidden h-auto w-7/10 dark:block"
  />
</span>

---
// Dependencies
import { getLocale, getTranslations } from "../../i18n/helpers";
import { NEWS_DRAWINGS } from "./constants";

// Components
import Opener from "../ui/Opener.astro";
import NewsDrawing from "./NewsDrawing.astro";
import NewsFilter from "./NewsFilter.astro";

// Types
import type { NewsFilter as Filter } from "../../lib/news/types";

/**
 * The {@link Props} type
 * @description The props of the NewsOpening component: News on sand with one line and the filter, beside the logo holding a stitched line with the kinds of post pinned to it
 */
type Props = {
  /** The type the list shows, or null for every post. */
  filter: Filter;
  /** Whether there are posts to filter. */
  hasPosts: boolean;
};

// Read the opening's content and copy
const { filter, hasPosts } = Astro.props;
const t = getTranslations(getLocale(Astro.currentLocale));
---

<section
  aria-labelledby="news-title"
  class="relative isolate -mt-16 overflow-hidden bg-bg-alt text-text-heading desktop:-mt-20 desktop:flex desktop:min-h-215 desktop:items-center desktop:pt-20 desktop:pb-14"
>
  <NewsDrawing
    layout={NEWS_DRAWINGS.PHONE}
    id="news-phone"
    class="pointer-events-none h-auto w-full tablet:hidden"
  />

  <div class="relative flex flex-col gap-6 px-margin pb-20 tablet:w-130 tablet:px-margin-md tablet:pt-34 tablet:pb-0 desktop:opening-words desktop:gap-8 desktop:pt-0 desktop:pr-0 desktop:pl-margin-lg">
    <div class="flex flex-col gap-3 tablet:gap-4">
      <Opener label={t["news.opener"]} />
      <h1 id="news-title" class="type-hero">
        {t["news.heading"]}
      </h1>
    </div>
    <p class="type-body text-pretty text-text desktop:max-w-lg desktop:type-lead">
      {t["news.intro"]}
    </p>
    {hasPosts ? (
      <div class="tablet:hidden desktop:block">
        <NewsFilter filter={filter} />
      </div>
    ) : null}
  </div>

  <div class="mx-auto hidden max-w-208.5 tablet:block desktop:hidden">
    <NewsDrawing
      layout={NEWS_DRAWINGS.TABLET}
      id="news-tablet"
      class="pointer-events-none h-auto w-full"
    />
  </div>
  {hasPosts ? (
    <div class="relative hidden px-margin-md pb-24 tablet:block desktop:hidden">
      <NewsFilter filter={filter} />
    </div>
  ) : null}
  <NewsDrawing
    layout={NEWS_DRAWINGS.DESKTOP}
    id="news-desktop"
    class="pointer-events-none opening-aside hidden desktop:block"
  />
</section>

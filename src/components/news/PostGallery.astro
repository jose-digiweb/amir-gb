---
// Dependencies
import { Image } from "emdash/ui";
import { getLocale, getTranslations } from "../../i18n/helpers";

// Components
import Opener from "../ui/Opener.astro";

// Types
import type { MediaImage } from "../../lib/content/types";

/**
 * The {@link Props} type
 * @description The props of the PostGallery component, Photos from the day: a two-column grid inside the reading column, the first photo spanning it larger
 */
type Props = {
  /** The photos, in the editor's order. */
  images: MediaImage[];
};

// Read the photos and the opener's copy
const { images } = Astro.props;
const t = getTranslations(getLocale(Astro.currentLocale));

// The first photo leads, spanning the column; the rest share it two by two
const [lead, ...rest] = images;
---

<div class="mt-10 flex flex-col gap-3.5 tablet:mt-14">
  <Opener label={t["news.galleryOpener"]} />
  <ul class="grid grid-cols-2 gap-2.5 tablet:gap-3.5">
    {lead ? (
      <li class="relative col-span-2 h-55 overflow-hidden rounded-lg bg-surface-sunken tablet:h-85 desktop:h-95">
        <Image
          image={lead}
          sizes="(min-width: 1180px) 720px, (min-width: 700px) 640px, calc(100vw - 40px)"
          class="absolute inset-0 size-full object-cover"
        />
      </li>
    ) : null}
    {rest.map((image) => (
      <li class="gallery-photo relative h-37.5 overflow-hidden rounded-lg bg-surface-sunken tablet:h-52.5 desktop:h-57.5">
        <Image
          image={image}
          sizes="(min-width: 1180px) 360px, (min-width: 700px) 320px, 50vw"
          class="absolute inset-0 size-full object-cover"
        />
      </li>
    ))}
  </ul>
</div>

<style>
  @reference "../../styles/global.css";

  /* A last photo left alone in its row spans the column */
  .gallery-photo:last-child:nth-child(even) {
    @apply col-span-2;
  }
</style>

---
// Dependencies
import { Check, Link, MessageCircle } from "@lucide/astro";
import { getLocale, getTranslations } from "../../i18n/helpers";
import { getWhatsAppShareHref } from "../../lib/share/helpers";
import { BUTTON_SIZE, BUTTON_TONE } from "../ui/constants";

// Components
import Button from "../ui/Button.astro";

/**
 * The {@link Props} type
 * @description The props of the PostShare component, Share this at the end of a post on phone and tablet (the desktop side column has its own): share the post on WhatsApp, or copy its link
 */
type Props = {
  /** The post's title, the message WhatsApp starts with. */
  title: string;
};

// Read the title and prepare the WhatsApp message with the page's address
const { title } = Astro.props;
const t = getTranslations(getLocale(Astro.currentLocale));
const shareHref = getWhatsAppShareHref(title, Astro.url.href);
---

<div
  data-copy-share
  class="group mt-9 grid grid-cols-2 gap-2.5 border-t border-border pt-6 tablet:mt-12 tablet:flex tablet:flex-wrap tablet:items-center desktop:hidden"
>
  <p class="col-span-2 type-button-sm text-text-heading tablet:mr-1">{t["news.share"]}</p>
  <Button
    href={shareHref}
    tone={BUTTON_TONE.OUTLINE}
    size={BUTTON_SIZE.COMPACT}
    target="_blank"
    rel="noopener"
    class="px-3 type-button-sm tablet:px-4.5"
  >
    <MessageCircle />
    {t["news.shareWhatsApp"]}
  </Button>
  <Button
    data-copy-link
    tone={BUTTON_TONE.OUTLINE}
    size={BUTTON_SIZE.COMPACT}
    class="px-3 type-button-sm tablet:px-4.5"
  >
    <Link class="group-data-copied:hidden" />
    <Check class="hidden text-success group-data-copied:block" />
    <span class="group-data-copied:hidden">{t["news.copyLink"]}</span>
    <span class="hidden group-data-copied:inline">{t["news.copied"]}</span>
  </Button>
  <p class="col-span-2 hidden basis-full type-small text-text-muted group-data-failed:block">
    {t["news.copyFailed"]}
  </p>
  <span
    role="status"
    class="sr-only"
    data-copy-status
    data-copied-text={t["news.copied"]}
    data-failed-text={t["news.copyFailed"]}
  ></span>
</div>

<script>
  // Dependencies
  import { enableCopyLink } from "../../lib/news/helpers";

  // Copy link copies the page's address and says so
  enableCopyLink();
</script>

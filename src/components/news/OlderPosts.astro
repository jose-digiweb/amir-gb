---
// Dependencies
import { ChevronDown, LoaderCircle } from "@lucide/astro";
import { getLocale, getTranslations } from "../../i18n/helpers";

/**
 * The {@link Props} type
 * @description The props of the OlderPosts component, the list's footer: Show older posts, resting as Loading older posts, or the end of the list
 */
type Props = {
  /** The next page's address, while older posts remain. */
  nextHref?: string;
  /** The visitor has loaded older posts and reached the last one. */
  isEnd: boolean;
};

// Read what the footer offers and its copy
const { nextHref, isEnd } = Astro.props;
const t = getTranslations(getLocale(Astro.currentLocale));
---

<div data-older-posts class="group mt-6 flex justify-center tablet:mt-12">
  {nextHref ? (
    <a
      href={nextHref}
      data-older-posts-link
      class="inline-flex h-control-lg touch-manipulation items-center justify-center gap-2 rounded-pill border-2 border-border-strong px-6 type-button text-text-heading transition-[background-color,scale] duration-fast ease-standard select-none group-data-busy:pointer-events-none hover:bg-hover-quiet active:scale-97"
    >
      <span aria-live="polite" class="contents">
        <span class="contents group-data-busy:hidden">
          {t["news.older"]}
          <ChevronDown class="size-5" />
        </span>
        <span class="hidden items-center gap-2 group-data-busy:inline-flex">
          <LoaderCircle class="size-5 animate-spin motion-reduce:animate-none" />
          {t["news.loadingOlder"]}
        </span>
      </span>
    </a>
  ) : null}
  {isEnd ? (
    <p class="flex items-center gap-3 type-body-sm text-text-muted">
      <span aria-hidden="true" class="h-px w-10 bg-border"></span>
      {t["news.end"]}
      <span aria-hidden="true" class="h-px w-10 bg-border"></span>
    </p>
  ) : null}
</div>

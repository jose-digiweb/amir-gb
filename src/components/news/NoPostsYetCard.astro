---
// Dependencies
import { ArrowRight, ExternalLink } from "@lucide/astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { siInstagram } from "simple-icons";
import { getLocale, getTranslations } from "../../i18n/helpers";
import { BEAD, LOZENGE } from "../../lib/woven/constants";
import { getWovenPath } from "../../lib/woven/helpers";
import { PENDING_LINK, ROUTE, SOCIAL_LINKS } from "../../site/constants";

/**
 * The {@link Props} type
 * @description The props of the NoPostsYetCard component, the message before the first post, with What's on and Instagram
 */
type Props = Record<string, never>;

// Prepare the copy, the links and the woven ring above the message
const locale = getLocale(Astro.currentLocale);
const t = getTranslations(locale);
const instagram =
  SOCIAL_LINKS.find((link) => link.name === siInstagram.title)?.href ?? PENDING_LINK;
const isPending = instagram === PENDING_LINK;
const ringPath = getWovenPath(
  LOZENGE.PIECE_RADIUS,
  (distance) => distance >= LOZENGE.PIECE_RING_FROM,
);
---

<div class="flex flex-col items-start gap-3 rounded-lg bg-surface p-6 text-text-heading tablet:max-w-xl tablet:p-8">
  <svg
    aria-hidden="true"
    viewBox={`0 0 ${BEAD.UNITS} ${BEAD.UNITS}`}
    class="mt-1 mb-2 size-16 self-center fill-accent tablet:self-start"
  >
    <path d={ringPath}></path>
  </svg>
  <h2 class="type-h3 text-balance">{t["news.emptyTitle"]}</h2>
  <p class="type-body text-pretty text-text">{t["news.emptyText"]}</p>
  <a
    href={getRelativeLocaleUrl(locale, ROUTE.EVENTS)}
    class="inline-flex min-h-tap items-center gap-2 type-button text-link"
  >
    <span class="underline decoration-2 underline-offset-4">{t["news.seeWhatsOn"]}</span>
    <ArrowRight class="size-5" />
  </a>
  <a
    href={instagram}
    target={isPending ? undefined : "_blank"}
    rel={isPending ? undefined : "noopener"}
    class="-mt-3 inline-flex min-h-tap items-center gap-2 type-button text-link"
  >
    <span class="underline decoration-2 underline-offset-4">{t["news.followInstagram"]}</span>
    <ExternalLink class="size-5" />
  </a>
</div>

---
// Dependencies
import { Image } from "emdash/ui";

// Types
import type { MediaImage } from "../../lib/content/types";

/**
 * The {@link Props} type
 * @description The props of the PinnedPrint component, a story photo pinned at an angle like a print in the News opening
 */
type Props = {
  /** The story's photo. */
  image: MediaImage;
  /** Place, size and angle classes from the caller. */
  class?: string;
};

// Read the photo and where it is pinned
const { image, class: className } = Astro.props;
---

<span
  class:list={[
    "absolute overflow-hidden rounded-lg bg-surface-sunken shadow-md ring-6 ring-surface",
    className,
  ]}
>
  <Image
    image={image}
    alt=""
    sizes="(min-width: 1180px) 250px, 170px"
    class="absolute inset-0 size-full object-cover"
  />
</span>

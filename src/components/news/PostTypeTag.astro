---
// Dependencies
import { getLocale, getTranslations } from "../../i18n/helpers";
import { POST_TYPE_COPY } from "../../lib/news/constants";

// Components
import PostTypeDot from "./PostTypeDot.astro";

// Types
import type { PostType } from "../../lib/content/types";

/**
 * The {@link Props} type
 * @description The props of the PostTypeTag component, a post's type as a small tag with its colour dot
 */
type Props = {
  /** The post's type. */
  type: PostType;
  /** The tag's ground from the caller: sand on a white card, white on sand. */
  class?: string;
};

// Read the type and name it in the page's language
const { type, class: className } = Astro.props;
const t = getTranslations(getLocale(Astro.currentLocale));
---

<span
  class:list={[
    "inline-flex h-6 shrink-0 items-center gap-1.5 self-start rounded-pill px-3 type-tag whitespace-nowrap text-text-heading",
    className,
  ]}
>
  <PostTypeDot type={type} class="size-2" />
  {t[POST_TYPE_COPY[type].tag]}
</span>

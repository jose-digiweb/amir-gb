---
// Dependencies
import { LOCALE } from "../../i18n/constants";
import { RICH_TEXT_SIZE } from "../content/constants";

// Components
import RichText from "../content/RichText.astro";
import DecorBead from "../ui/DecorBead.astro";
import DotPatch from "../ui/DotPatch.astro";
import WovenShade from "../ui/WovenShade.astro";
import BoardSignature from "./BoardSignature.astro";
import PostEventLink from "./PostEventLink.astro";
import PostGallery from "./PostGallery.astro";
import PostAside from "./PostAside.astro";
import PostMeta from "./PostMeta.astro";
import PostPhoto from "./PostPhoto.astro";
import PostShare from "./PostShare.astro";
import PostTitle from "./PostTitle.astro";

// Types
import type { NewsArticle } from "../../lib/news/types";

/**
 * The {@link Props} type
 * @description The props of the PostSection component, the post itself in one reading column: type and date, title, photo, text, event, signature, photos from the day and Share, with the side column beside it on desktop
 */
type Props = {
  /** Everything the post shows. */
  article: NewsArticle;
  /** Nothing follows it, so the footer overlaps it. */
  isLast: boolean;
};

// Read the post and what it carries
const { article, isLast } = Astro.props;
const { post, content, event, boardNames, gallery } = article;
const lang = post.isDutchOnly ? LOCALE.NL : undefined;
const hasGallery = gallery.length > 0;
const hasPhoto = Boolean(post.image);
---

<section
  data-footer-overlaps={isLast ? "" : undefined}
  class="relative isolate -mt-16 overflow-clip bg-bg px-margin pt-24 pb-20 text-text-heading tablet:px-margin-md tablet:pt-28 tablet:pb-32 desktop:-mt-20 desktop:px-margin-lg desktop:pt-36 desktop:pb-32"
>
  <WovenShade />
  <DecorBead ringed class="top-25 right-6 size-7 tablet:top-34 tablet:right-32 desktop:right-36" />
  <DotPatch id="news-post" class="top-35 -left-5 h-35 w-50" />

  <div class="mx-auto max-w-160 desktop:grid desktop:max-w-none desktop:grid-cols-[--spacing(60)_--spacing(180)] desktop:items-start desktop:justify-center desktop:gap-x-22">
    <PostAside post={post} />
    <article class="min-w-0">
      <div class="flex flex-col gap-3.5">
        <PostMeta post={post} />
        <PostTitle post={post} />
      </div>
      <div
        class:list={[
          "relative mt-7 overflow-hidden rounded-xl bg-surface-sunken tablet:mt-10",
          {
            "h-60 tablet:h-100 desktop:h-112.5": hasPhoto,
            "h-45 tablet:h-60 desktop:h-72": !hasPhoto,
          },
        ]}
      >
        <PostPhoto
          image={post.image}
          type={post.type}
          sizes="(min-width: 1180px) 720px, (min-width: 700px) 640px, calc(100vw - 40px)"
          isDescribed
          priority
        />
      </div>
      <div lang={lang} class="mt-7 flex flex-col gap-6 tablet:mt-10">
        <RichText value={content} size={RICH_TEXT_SIZE.READ} />
        {event ? <PostEventLink event={event} /> : null}
        {boardNames ? <BoardSignature names={boardNames} /> : null}
      </div>
      {hasGallery ? <PostGallery images={gallery} /> : null}
      <PostShare title={post.title} />
    </article>
  </div>
</section>

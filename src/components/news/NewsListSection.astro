---
// Dependencies
import { NEWS_LIST_STATE } from "../../lib/news/constants";

// Components
import DotPatch from "../ui/DotPatch.astro";
import WovenShade from "../ui/WovenShade.astro";
import FeaturedPostCard from "./FeaturedPostCard.astro";
import NoPostsOfTypeCard from "./NoPostsOfTypeCard.astro";
import NoPostsYetCard from "./NoPostsYetCard.astro";
import OlderPosts from "./OlderPosts.astro";
import PostListItem from "./PostListItem.astro";

// Types
import type { NewsFilter, NewsListState, NewsPost } from "../../lib/news/types";

/**
 * The {@link Props} type
 * @description The props of the NewsListSection component, the paper sheet with the newest post, the rest of the list and Show older posts, or the message when there is nothing to show
 */
type Props = {
  /** What the list shows. */
  state: NewsListState;
  /** The type the list is filtered to, or null. */
  filter: NewsFilter;
  /** The newest post. */
  featured?: NewsPost;
  /** The posts under it. */
  posts: NewsPost[];
  /** The next page's address, while older posts remain. */
  nextHref?: string;
  /** The visitor has loaded older posts and reached the last one. */
  isEnd: boolean;
};

// Read what the list shows
const { state, filter, featured, posts, nextHref, isEnd } = Astro.props;
const hasPosts = posts.length > 0;
---

<section
  data-footer-overlaps
  class="relative isolate -mt-8 overflow-hidden rounded-t-xl bg-bg px-margin pt-8 pb-20 tablet:-mt-10 tablet:px-margin-md tablet:pt-10 tablet:pb-24 desktop:-mt-14 desktop:px-margin-lg desktop:pt-12 desktop:pb-36"
>
  <WovenShade />
  <DotPatch
    id="news-list"
    class="bottom-40 -left-5 h-30 w-40 tablet:bottom-60 tablet:-left-10 tablet:h-45 tablet:w-65"
  />

  <div class="mx-auto max-w-page">
    {featured ? <FeaturedPostCard post={featured} /> : null}
    {hasPosts ? (
      <ul
        data-news-list
        class="mt-3.5 rounded-lg bg-surface px-4 tablet:mt-10 tablet:grid tablet:grid-cols-2 tablet:gap-x-6 tablet:gap-y-10 tablet:bg-transparent tablet:px-0 desktop:mt-12 desktop:grid-cols-3 desktop:gap-x-8 desktop:gap-y-12"
      >
        {posts.map((post) => (
          <PostListItem post={post} />
        ))}
      </ul>
    ) : null}
    {state === NEWS_LIST_STATE.POSTS ? <OlderPosts nextHref={nextHref} isEnd={isEnd} /> : null}
    {state === NEWS_LIST_STATE.EMPTY_TYPE && filter ? <NoPostsOfTypeCard type={filter} /> : null}
    {state === NEWS_LIST_STATE.EMPTY ? <NoPostsYetCard /> : null}
  </div>
</section>

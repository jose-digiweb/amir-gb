---
// Types
import type { ArchiveYear } from "../../../lib/events/types";

/**
 * The {@link Props} type
 * @description The props of the ArchiveYearChip component, one year of the archive: gold when it is the year shown
 */
type Props = {
  /** The year and its link. */
  year: ArchiveYear;
};

// Read the year
const { year } = Astro.props;
---

<li>
  <a
    href={year.href}
    aria-current={year.isPicked ? "page" : undefined}
    class:list={[
      "relative inline-flex h-10 touch-manipulation items-center rounded-pill px-4 type-button-sm transition-colors duration-base ease-standard select-none after:absolute after:inset-x-0 after:-inset-y-1",
      {
        "bg-accent text-on-accent-fill": year.isPicked,
        "bg-surface text-text-heading hover:bg-hover-quiet": !year.isPicked,
      },
    ]}
  >
    {year.year}
  </a>
</li>

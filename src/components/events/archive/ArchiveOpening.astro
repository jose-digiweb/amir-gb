---
// Dependencies
import { getLocale, getTranslations } from "../../../i18n/helpers";
import { ARCHIVE_DRAWINGS } from "./constants";

// Components
import BackToEventsLink from "../BackToEventsLink.astro";
import Opener from "../../ui/Opener.astro";
import ArchiveDrawing from "./ArchiveDrawing.astro";
import ArchiveYearChip from "./ArchiveYearChip.astro";

// Types
import type { ArchiveYear, TimelineMonth } from "../../../lib/events/types";

/**
 * The {@link Props} type
 * @description The props of the ArchiveOpening component, Past events on sand with the year chips, beside a stitched timeline from the logo with the past events hanging off it
 */
type Props = {
  /** The years with past events. */
  years: ArchiveYear[];
  /** The recent months with their past events, oldest first. */
  timeline: TimelineMonth[];
};

// Read the years, the timeline and the copy
const { years, timeline } = Astro.props;
const t = getTranslations(getLocale(Astro.currentLocale));
---

<section
  aria-labelledby="archive-title"
  class="relative isolate -mt-16 overflow-hidden bg-bg-alt text-text-heading desktop:-mt-20 desktop:flex desktop:min-h-215 desktop:items-center desktop:pt-20 desktop:pb-14"
>
  <ArchiveDrawing
    layout={ARCHIVE_DRAWINGS.PHONE}
    months={timeline}
    id="archive-phone"
    class="pointer-events-none h-auto w-full tablet:hidden"
  />

  <div class="relative flex flex-col gap-6 px-margin pb-20 tablet:w-130 tablet:px-margin-md tablet:pt-30 tablet:pb-0 desktop:opening-words desktop:gap-8 desktop:pt-0 desktop:pr-0 desktop:pl-margin-lg">
    <div class="flex flex-col gap-3 tablet:gap-4">
      <BackToEventsLink />
      <Opener label={t["eventsPage.pastOpener"]} />
      <h1 id="archive-title" class="type-hero text-balance">
        {t["archive.title"]}
      </h1>
    </div>
    <p class="type-body text-pretty text-text desktop:max-w-lg desktop:type-lead">
      {t["archive.intro"]}
    </p>
    <ul aria-label={t["archive.yearsLabel"]} class="flex flex-wrap gap-2">
      {years.map((year) => (
        <ArchiveYearChip year={year} />
      ))}
    </ul>
  </div>

  <div class="mx-auto hidden max-w-208.5 tablet:block desktop:hidden">
    <ArchiveDrawing
      layout={ARCHIVE_DRAWINGS.TABLET}
      months={timeline}
      id="archive-tablet"
      class="pointer-events-none h-auto w-full"
    />
  </div>
  <ArchiveDrawing
    layout={ARCHIVE_DRAWINGS.DESKTOP}
    months={timeline}
    id="archive-desktop"
    class="pointer-events-none opening-aside hidden desktop:block"
  />
</section>

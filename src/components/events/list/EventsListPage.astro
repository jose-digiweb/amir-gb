---
// Dependencies
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLocale, getTranslations } from "../../../i18n/helpers";
import { EVENTS_PARAM, EVENTS_VIEW } from "../../../lib/events/constants";
import { buildEventsHref, getTypeChips } from "../../../lib/events/helpers";
import { ROUTE } from "../../../site/constants";

// Components
import SiteLayout from "../../../layouts/SiteLayout.astro";
import WovenDefs from "../../ui/WovenDefs.astro";
import EventsOpening from "../EventsOpening.astro";
import WeeklyAndPastSection from "../WeeklyAndPastSection.astro";
import EventsListSection from "./EventsListSection.astro";

// Types
import type { EventsListContent, EventType } from "../../../lib/events/types";

/**
 * The {@link Props} type
 * @description The props of the EventsListPage component, What's on as a list in the page's language
 */
type Props = {
  /** What the list shows. */
  content: EventsListContent;
  /** The type filter, if any. */
  type?: EventType;
};

// Read the content and link the views, the chips and the archive in the page's language
const { content, type } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = getTranslations(locale);
const listPath = getRelativeLocaleUrl(locale, ROUTE.EVENTS);
const calendarPath = getRelativeLocaleUrl(locale, ROUTE.EVENTS_CALENDAR);
---

<SiteLayout title={t["eventsPage.title"]} description={t["eventsPage.description"]}>
  <WovenDefs />
  <EventsOpening
    view={EVENTS_VIEW.LIST}
    listHref={buildEventsHref(listPath, { [EVENTS_PARAM.TYPE]: type })}
    calendarHref={buildEventsHref(calendarPath, { [EVENTS_PARAM.TYPE]: type })}
    chips={getTypeChips(listPath, type)}
    orbit={content.orbit}
  />
  <EventsListSection next={content.next} months={content.months} type={type} allHref={listPath} />
  <WeeklyAndPastSection
    activities={content.activities}
    past={content.past}
    archiveHref={getRelativeLocaleUrl(locale, ROUTE.EVENTS_ARCHIVE)}
  />
</SiteLayout>

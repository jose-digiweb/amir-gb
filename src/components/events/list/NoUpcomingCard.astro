---
// Dependencies
import { CalendarDays } from "@lucide/astro";
import { getLocale, getTranslations } from "../../../i18n/helpers";

// Components
import ListMessageCard from "./ListMessageCard.astro";

/**
 * The {@link Props} type
 * @description The props of the NoUpcomingCard component, the calm card the list shows while no event is announced
 */
type Props = Record<string, never>;

// Read the copy
const t = getTranslations(getLocale(Astro.currentLocale));
---

<ListMessageCard title={t["events.noneTitle"]} text={t["eventsPage.noneText"]}>
  <CalendarDays slot="icon" aria-hidden="true" />
</ListMessageCard>

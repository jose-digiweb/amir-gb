---
// Dependencies
import { Image } from "emdash/ui";
import { getPhotoAlt } from "../../lib/content/helpers";
import pintiPanel from "../../assets/woven/pinti-panel.svg";

// Types
import type { MediaImage } from "../../lib/content/types";

/**
 * The {@link Props} type
 * @description The props of the EventCover component, an event's photo filling its frame, or the woven pinti panel when it has none
 */
type Props = {
  /** The event's image, if it has one. */
  image?: MediaImage;
  /** The widths the photo is shown at, for the browser to pick a file. */
  sizes: string;
  /** The photo is a page's own lead photo, so it carries the editor's description; in a list the link's words say it. */
  isDescribed?: boolean;
  /** The photo is the page's largest paint, so it loads first. */
  priority?: boolean;
};

// Read the image and how wide it shows
const { image, sizes, isDescribed = false, priority = false } = Astro.props;

// A lead photo says what it shows; a photo in a list is left to the link's words
const alt = getPhotoAlt(image, isDescribed);
---

{image ? (
  <Image
    image={image}
    alt={alt}
    sizes={sizes}
    priority={priority}
    class="absolute inset-0 size-full object-cover"
  />
) : (
  <img
    src={pintiPanel.src}
    alt=""
    loading={priority ? "eager" : "lazy"}
    class="absolute inset-0 size-full object-cover"
  />
)}

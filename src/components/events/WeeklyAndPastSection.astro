---
// Dependencies
import { ArrowRight } from "@lucide/astro";
import { getLocale, getTranslations } from "../../i18n/helpers";
import { BUTTON_TONE } from "../ui/constants";

// Components
import Button from "../ui/Button.astro";
import DecorBead from "../ui/DecorBead.astro";
import DotPatch from "../ui/DotPatch.astro";
import Opener from "../ui/Opener.astro";
import WovenShade from "../ui/WovenShade.astro";
import PastEventTile from "./PastEventTile.astro";
import WeeklyActivityTile from "./WeeklyActivityTile.astro";

// Types
import type { WeeklyActivity } from "../../lib/content/types";
import type { EventItem } from "../../lib/events/types";

/**
 * The {@link Props} type
 * @description The props of the WeeklyAndPastSection component, the sand card under the list and the calendar: the weekly activities, and the latest past events with the way to the archive
 */
type Props = {
  /** The weekly activities, Monday first. */
  activities: WeeklyActivity[];
  /** The latest past events, newest first. */
  past: EventItem[];
  /** The archive's address. */
  archiveHref: string;
};

// Read what the card holds; it is left out when it has nothing
const { activities, past, archiveHref } = Astro.props;
const t = getTranslations(getLocale(Astro.currentLocale));
const hasWeekly = activities.length > 0;
const hasPast = past.length > 0;
---

{hasWeekly || hasPast ? (
  <section
    data-footer-overlaps
    class="relative isolate z-10 -mt-8 overflow-hidden rounded-t-xl bg-bg-alt px-margin pt-10 pb-20 tablet:-mt-10 tablet:px-margin-md tablet:pt-16 tablet:pb-28 desktop:-mt-14 desktop:px-margin-lg desktop:pt-24 desktop:pb-36"
  >
    <WovenShade />
    <DecorBead ringed class="top-14 right-8 size-6 desktop:right-36 desktop:size-7" />
    <DecorBead class="right-9 bottom-16 size-4.5 desktop:hidden" />
    <DotPatch id="weekly-dots" class="bottom-28 -left-5 h-40 w-55" />
    <div class="flex flex-col gap-9 desktop:grid desktop:grid-cols-12 desktop:gap-16">
      {hasWeekly ? (
        <div class="flex flex-col gap-2 desktop:col-span-5">
          <Opener label={t["weekly.label"]} />
          <h2 class="type-section-title text-balance text-text-heading">
            {t["eventsPage.weeklyTitle"]}
          </h2>
          <ul class="mt-3 grid grid-cols-2 gap-3 tablet:gap-4">
            {activities.map((activity) => (
              <WeeklyActivityTile activity={activity} />
            ))}
          </ul>
        </div>
      ) : null}
      {hasPast ? (
        <div
          class:list={[
            "flex min-w-0 flex-col gap-2",
            { "desktop:col-span-7": hasWeekly, "desktop:col-span-12": !hasWeekly },
          ]}
        >
          <Opener label={t["eventsPage.pastOpener"]} />
          <h2 class="type-section-title text-balance text-text-heading">
            {t["eventsPage.pastTitle"]}
          </h2>
          <ul class="past-rail mt-3 -mr-margin flex gap-3 overflow-x-auto pr-margin tablet:mr-0 tablet:grid tablet:grid-cols-2 tablet:gap-4 tablet:overflow-visible tablet:pr-0 desktop:grid-cols-3">
            {past.map((event) => (
              <li class="w-54 shrink-0 tablet:w-auto tablet:nth-3:hidden desktop:nth-3:block">
                <PastEventTile event={event} />
              </li>
            ))}
          </ul>
          <Button href={archiveHref} tone={BUTTON_TONE.OUTLINE} class="mt-4 self-start">
            {t["eventsPage.seeArchive"]}
            <ArrowRight aria-hidden="true" />
          </Button>
        </div>
      ) : null}
    </div>
  </section>
) : null}

<style>
  @reference "../../styles/global.css";

  .past-rail {
    scrollbar-width: none;
  }
</style>

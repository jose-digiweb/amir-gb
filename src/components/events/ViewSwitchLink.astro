---
/**
 * The {@link Props} type
 * @description The props of the ViewSwitchLink component, one half of the List and Calendar switch: raised when it is the view shown
 */
type Props = {
  /** Where the view is. */
  href: string;
  /** The page shows this view. */
  isCurrent: boolean;
};

// Read the link and whether it is the current view
const { href, isCurrent } = Astro.props;
---

<a
  href={href}
  aria-current={isCurrent ? "page" : undefined}
  class:list={[
    "flex h-control touch-manipulation items-center justify-center gap-2 rounded-pill type-button transition-colors duration-base ease-standard select-none [&_svg]:size-4.5",
    {
      "bg-surface-raised text-text-heading shadow-sm forced-colors:border-2 forced-colors:border-[Highlight]":
        isCurrent,
      "text-text-heading hover:bg-hover-quiet active:bg-pressed-quiet": !isCurrent,
    },
  ]}
>
  <slot />
</a>

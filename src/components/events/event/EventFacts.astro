---
// Dependencies
import { EVENT_STATUS } from "../../../lib/content/constants";
import { EVENT_PHASE } from "../../../lib/events/constants";
import { getPlaceQuery } from "../../../lib/events/helpers";

// Components
import EndedEventActions from "./EndedEventActions.astro";
import ForWhomRow from "./ForWhomRow.astro";
import LanguagesRow from "./LanguagesRow.astro";
import OnlineRow from "./OnlineRow.astro";
import OpenEventActions from "./OpenEventActions.astro";
import SignUpActions from "./SignUpActions.astro";
import WhenRow from "./WhenRow.astro";
import WhereRow from "./WhereRow.astro";

// Types
import type { EventDetail, EventPhase } from "../../../lib/events/types";

/**
 * The {@link Props} type
 * @description The props of the EventFacts component, the white card with when, where, online, languages and for whom, and the event's actions
 */
type Props = {
  /** The event. */
  event: EventDetail;
  /** Whether it is still to come or has ended. */
  phase: EventPhase;
  /** The story with photos of the day, once it has ended. */
  storyHref?: string;
  /** The moment the page renders. */
  now: Date;
};

// Read the event and work out which rows and actions it has
const { event, phase, storyHref, now } = Astro.props;
const isCancelled = event.status === EVENT_STATUS.CANCELLED;
const isLive = phase === EVENT_PHASE.UPCOMING && !isCancelled;
const hasPlace = Boolean(getPlaceQuery(event));
const signUpLink = isLive ? event.registrationLink : undefined;
const isOpen = isLive && !signUpLink;
const photosHref = isCancelled ? undefined : storyHref;
---

<div class="flex flex-col gap-5 rounded-lg border border-border bg-surface p-5 shadow-md tablet:p-6">
  <ul class="flex flex-col">
    <WhenRow event={event} />
    {hasPlace ? <WhereRow event={event} showMaps={!isCancelled} /> : null}
    {event.onlineLink ? (
      <OnlineRow event={event} href={event.onlineLink} isLive={isLive} now={now} />
    ) : null}
    <LanguagesRow languages={event.languages} />
    <ForWhomRow forWhom={event.forWhom} showJoin={!isCancelled} />
  </ul>
  {signUpLink ? <SignUpActions registrationLink={signUpLink} href={event.href} /> : null}
  {isOpen ? <OpenEventActions event={event} /> : null}
  {isLive ? null : <EndedEventActions storyHref={photosHref} />}
</div>

---
// Dependencies
import { DEFAULT_LOCALE } from "../../../i18n/constants";
import { getLocale, getTranslations } from "../../../i18n/helpers";
import { EVENT_STATUS } from "../../../lib/content/constants";
import { EVENT_PHASE } from "../../../lib/events/constants";
import { isOnlineOnly } from "../../../lib/events/helpers";
import { getRelativeLocaleUrl } from "astro:i18n";
import { SEO } from "../../../lib/seo/constants";
import { getEntryPageSeo, toAbsoluteUrl } from "../../../lib/seo/helpers";
import { getBreadcrumbSchema, getEventSchema } from "../../../lib/seo/structured-data";
import { ROUTE } from "../../../site/constants";
import { EVENTS_PLACEHOLDER } from "../constants";

// Components
import SiteLayout from "../../../layouts/SiteLayout.astro";
import DecorBead from "../../ui/DecorBead.astro";
import DotPatch from "../../ui/DotPatch.astro";
import WovenDefs from "../../ui/WovenDefs.astro";
import WovenShade from "../../ui/WovenShade.astro";
import CancelledNote from "./CancelledNote.astro";
import DutchOnlyNote from "./DutchOnlyNote.astro";
import EndedNote from "./EndedNote.astro";
import EventAbout from "./EventAbout.astro";
import EventFacts from "./EventFacts.astro";
import EventHeader from "./EventHeader.astro";
import EventMedia from "./EventMedia.astro";
import MovedNote from "./MovedNote.astro";
import OtherEventsSection from "./OtherEventsSection.astro";

// Types
import type { EventPageContent } from "../../../lib/events/types";
import type { LanguageAlternate } from "../../../lib/seo/types";

/**
 * The {@link Props} type
 * @description The props of the EventPage component, one event: its name and picture, its facts and actions, what it is about, and the events after it
 */
type Props = {
  /** What the page shows. */
  content: EventPageContent;
  /** The moment the page renders. */
  now: Date;
  /** The event's language versions for search engines. */
  alternates: LanguageAlternate[];
};

// Read the event and its state, and describe the page for search and link previews
const { content, now, alternates } = Astro.props;
const { event, phase, storyHref, others } = content;
const locale = getLocale(Astro.currentLocale);
const t = getTranslations(locale);
const isCancelled = event.status === EVENT_STATUS.CANCELLED;
const isMoved = event.status === EVENT_STATUS.MOVED;
const isEnded = phase === EVENT_PHASE.ENDED && !isCancelled;
const description = event.summary ?? t["eventsPage.description"];
const title = t["event.pageTitle"].replace(
  EVENTS_PLACEHOLDER.TITLE,
  event.seo?.title ?? event.title,
);
const entrySeo = getEntryPageSeo({
  alternates,
  isDutchOnly: event.isDutchOnly,
  defaultLocale: DEFAULT_LOCALE,
  seo: event.seo,
  image: event.image?.src,
  imageAlt: event.image?.alt,
});

// Describe the event and its place in the site for search engines, at its canonical address
const site = new URL(Astro.site ?? Astro.url.origin);
const pageUrl = entrySeo.canonical ?? toAbsoluteUrl(Astro.url.pathname, site);
const seo = {
  ...entrySeo,
  structuredData: [
    getEventSchema({
      site,
      url: pageUrl,
      name: event.title,
      status: event.status,
      startsAt: event.startsAt,
      endsAt: event.endsAt,
      originalStartsAt: event.originalStartsAt,
      placeName: event.placeName,
      address: event.address,
      isOnline: Boolean(event.onlineLink),
      image: entrySeo.image,
      description: entrySeo.description ?? event.summary,
      locale: entrySeo.contentLocale ?? locale,
    }),
    getBreadcrumbSchema(
      [
        { name: SEO.SITE_NAME, path: getRelativeLocaleUrl(locale, ROUTE.HOME) },
        { name: t["nav.events"], path: getRelativeLocaleUrl(locale, ROUTE.EVENTS) },
        { name: event.title, path: pageUrl },
      ],
      site,
    ),
  ],
};
---

<SiteLayout title={title} description={description} seo={seo}>
  <WovenDefs />
  <article
    data-footer-overlaps
    aria-labelledby="event-title"
    class="relative isolate overflow-hidden bg-bg px-margin pt-6 pb-20 tablet:px-margin-md tablet:pt-10 tablet:pb-28 desktop:px-margin-lg desktop:pt-14 desktop:pb-36"
  >
    <WovenShade />
    <DecorBead ringed class="top-14 right-10 size-6 desktop:top-16 desktop:right-36" />
    <DotPatch
      id="event-dots"
      class="top-20 -left-5 h-20 w-30 desktop:top-24 desktop:h-28 desktop:w-44"
    />
    <div class="event-layout grid gap-5 tablet:gap-x-6 tablet:gap-y-8 desktop:gap-x-8">
      <div class="event-head flex flex-col gap-4">
        {event.isDutchOnly ? <DutchOnlyNote /> : null}
        {isCancelled ? <CancelledNote /> : null}
        {isMoved && !isEnded ? <MovedNote startsAt={event.startsAt} /> : null}
        {isEnded ? <EndedNote hasPhotos={Boolean(storyHref)} /> : null}
        <EventHeader event={event} isOnlineOnly={isOnlineOnly(event)} />
      </div>
      <div class="event-media">
        <EventMedia event={event} />
      </div>
      <div class="event-facts desktop:sticky desktop:top-24">
        <EventFacts event={event} phase={phase} storyHref={storyHref} now={now} />
      </div>
      <EventAbout event={event} class="event-about" />
    </div>
  </article>
  <OtherEventsSection events={others} />
</SiteLayout>

<style>
  @reference "../../../styles/global.css";

  .event-layout {
    grid-template-areas: "head" "media" "facts" "about";

    @variant tablet {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: "head head" "media media" "about facts";
      align-items: start;
    }

    @variant desktop {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      grid-template-areas: "head facts" "media facts" "about facts";
      grid-template-rows: auto auto 1fr;
    }
  }

  .event-head {
    grid-area: head;
  }

  .event-media {
    grid-area: media;
  }

  .event-facts {
    grid-area: facts;
  }

  .event-about {
    grid-area: about;
  }
</style>

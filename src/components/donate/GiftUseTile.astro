---
// Dependencies
import { TILE_COLOUR } from "../../lib/content/constants";

// Components
import GiftUseIcon from "./GiftUseIcon.astro";

// Types
import type { TileColour } from "../../lib/content/types";
import type { GiftUse } from "./types";

/**
 * The {@link Props} type
 * @description The props of the GiftUseTile component, one thing gifts are for as a tinted tile with its pictogram, title and line
 */
type Props = {
  /** What the gift is for. */
  use: GiftUse;
  /** The tile's tint. */
  tint: TileColour;
  /** The tile's title. */
  title: string;
  /** One line about it. */
  text: string;
};

// Read the tile's use, tint and words
const { use, tint, title, text } = Astro.props;
---

<article
  class:list={[
    "flex h-full flex-col gap-3 rounded-lg p-3 text-text-heading tablet:p-6",
    {
      "bg-tint-gold": tint === TILE_COLOUR.GOLD,
      "bg-tint-forest": tint === TILE_COLOUR.FOREST,
      "bg-tint-brick": tint === TILE_COLOUR.BRICK,
      "bg-tint-navy": tint === TILE_COLOUR.NAVY,
    },
  ]}
>
  <span class="grid size-12 place-items-center rounded-full bg-tile-icon desktop:size-14">
    <GiftUseIcon use={use} class="size-icon-md" />
  </span>
  <h3 class="type-h4 text-balance hyphens-auto tablet:type-h3">{title}</h3>
  <p class="type-body-sm text-pretty hyphens-auto text-text tablet:type-body">{text}</p>
</article>

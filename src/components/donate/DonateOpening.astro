---
// Dependencies
import { getLocale, getTranslations } from "../../i18n/helpers";
import { DONATE_DRAWINGS } from "./constants";

// Components
import DonationWidget from "../support/DonationWidget.astro";
import Opener from "../ui/Opener.astro";
import DonateDrawing from "./DonateDrawing.astro";

// Types
import type { SupportState } from "../../lib/donate/types";

/**
 * The {@link Props} type
 * @description The props of the DonateOpening component: Support our community on sand with the donation widget, or the result of a gift in its place, beside the joined hands and the threads to what gifts pay for
 */
type Props = {
  /** The form, or the result of a return from Stripe, read by the page route. */
  support: SupportState;
};

// Read the state and the copy
const { support } = Astro.props;
const t = getTranslations(getLocale(Astro.currentLocale));
---

<section
  aria-labelledby="donate-title"
  class="relative isolate -mt-16 overflow-hidden bg-bg-alt text-text-heading desktop:-mt-20 desktop:flex desktop:min-h-265 desktop:items-center desktop:pt-20 desktop:pb-14"
>
  <DonateDrawing
    layout={DONATE_DRAWINGS.PHONE}
    id="donate-phone"
    class="pointer-events-none h-auto w-full tablet:hidden"
  />

  <div class="relative grid gap-6 px-margin pb-20 tablet:grid-cols-[minmax(0,1fr)_--spacing(95)] tablet:items-start tablet:gap-8 tablet:px-margin-md tablet:pt-34 tablet:pb-0 desktop:opening-words desktop:grid-cols-1 desktop:pt-0 desktop:pr-0 desktop:pl-margin-lg">
    <div class="flex flex-col gap-6 desktop:gap-8">
      <div class="flex flex-col gap-3 tablet:gap-4">
        <Opener label={t["donatePage.opener"]} />
        <h1 id="donate-title" class="type-display desktop:type-hero">
          <span class="block">{t["donatePage.titleStart"]}</span>
          <span class="block">{t["donatePage.titleEnd"]}</span>
        </h1>
      </div>
      <p class="type-body text-pretty text-text desktop:max-w-md desktop:type-lead">
        {t["donatePage.text"]}
      </p>
    </div>
    <DonationWidget
      id="support"
      support={support}
      class="relative z-10 scroll-mt-8 desktop:max-w-115"
    />
  </div>

  <div class="mx-auto hidden max-w-208.5 tablet:block desktop:hidden">
    <DonateDrawing
      layout={DONATE_DRAWINGS.TABLET}
      id="donate-tablet"
      class="pointer-events-none h-auto w-full"
    />
  </div>
  <DonateDrawing
    layout={DONATE_DRAWINGS.DESKTOP}
    id="donate-desktop"
    class="pointer-events-none opening-aside hidden desktop:block"
  />
</section>

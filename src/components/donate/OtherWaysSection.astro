---
// Dependencies
import { getLocale, getTranslations } from "../../i18n/helpers";

// Components
import Opener from "../ui/Opener.astro";
import WovenShade from "../ui/WovenShade.astro";
import BankTransferCard from "./BankTransferCard.astro";
import DotPatch from "./DotPatch.astro";
import MonthlyGiftCard from "./MonthlyGiftCard.astro";
import TaxCard from "./TaxCard.astro";

/**
 * The {@link Props} type
 * @description The props of the OtherWaysSection component: Other ways and questions, the bank transfer, a monthly gift and tax, on sand, sliding under the footer
 */
type Props = Record<string, never>;

// Read the copy
const t = getTranslations(getLocale(Astro.currentLocale));
---

<section
  aria-labelledby="other-ways-title"
  data-under-footer
  class="relative isolate -mt-10 overflow-hidden rounded-t-xl bg-bg-alt px-margin pt-12 pb-24 text-text tablet:-mt-12 tablet:px-margin-md tablet:pt-16 tablet:pb-28 desktop:-mt-14 desktop:px-margin-lg desktop:pt-24 desktop:pb-36"
>
  <WovenShade />
  <DotPatch id="other-ways-dots" class="bottom-20 -left-5 h-40 w-56" />
  <div class="mx-auto flex w-full max-w-page flex-col gap-6 tablet:gap-10">
    <div class="flex flex-col gap-3">
      <Opener label={t["donatePage.waysOpener"]} />
      <h2 id="other-ways-title" class="type-section-title text-balance text-text-heading">
        {t["donatePage.waysTitle"]}
      </h2>
    </div>
    <ul class="grid gap-3 tablet:grid-cols-2 tablet:gap-5 desktop:grid-cols-3">
      <li class="tablet:col-span-2 desktop:col-span-1">
        <BankTransferCard />
      </li>
      <li>
        <MonthlyGiftCard />
      </li>
      <li>
        <TaxCard />
      </li>
    </ul>
  </div>
</section>

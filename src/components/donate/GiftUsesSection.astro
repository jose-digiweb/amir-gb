---
// Dependencies
import { getLocale, getTranslations } from "../../i18n/helpers";
import { GIFT_USES } from "./constants";

// Components
import Opener from "../ui/Opener.astro";
import WovenShade from "../ui/WovenShade.astro";
import GiftUseTile from "./GiftUseTile.astro";

/**
 * The {@link Props} type
 * @description The props of the GiftUsesSection component: What your gift does, four tinted tiles from AMIR-GB's own plan
 */
type Props = Record<string, never>;

// Read the copy and bake each tile's words before the loop
const t = getTranslations(getLocale(Astro.currentLocale));
const tiles = GIFT_USES.map((tile) => ({
  use: tile.use,
  tint: tile.tint,
  title: t[tile.title],
  text: t[tile.text],
}));
---

<section
  aria-labelledby="gift-uses-title"
  class="relative isolate -mt-10 overflow-hidden rounded-t-xl bg-bg px-margin pt-12 pb-24 text-text tablet:-mt-12 tablet:px-margin-md tablet:pt-16 tablet:pb-28 desktop:-mt-14 desktop:px-margin-lg desktop:pt-24 desktop:pb-36"
>
  <WovenShade />
  <div class="mx-auto flex w-full max-w-page flex-col gap-6 tablet:gap-10">
    <div class="flex flex-col gap-3">
      <Opener label={t["donatePage.usesOpener"]} />
      <h2 id="gift-uses-title" class="type-section-title text-balance text-text-heading">
        {t["donatePage.usesTitle"]}
      </h2>
      <p class="max-w-measure type-body text-pretty text-text-muted">{t["donatePage.usesText"]}</p>
    </div>
    <ul class="grid grid-cols-2 gap-3 tablet:gap-5 desktop:grid-cols-4">
      {tiles.map((tile) => (
        <li>
          <GiftUseTile use={tile.use} tint={tile.tint} title={tile.title} text={tile.text} />
        </li>
      ))}
    </ul>
  </div>
</section>

---
// Dependencies
import { ShieldCheck } from "@lucide/astro";
import { actions } from "astro:actions";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLocale, getTranslations } from "../../i18n/helpers";
import { CONTACT, ROUTE } from "../../site/constants";
import { MESSAGE_ANCHOR } from "./constants";
import { getContactFormCopy } from "./helpers";

// Components
import DecorBead from "../ui/DecorBead.astro";
import DotPatch from "../ui/DotPatch.astro";
import Opener from "../ui/Opener.astro";
import WovenShade from "../ui/WovenShade.astro";
import ContactForm from "./ContactForm.vue";

// Types
import type { ContactFormStart } from "./types";

/**
 * The {@link Props} type
 * @description The props of the MessageSection component: Send us a message, with the words beside the form on desktop
 */
type Props = {
  /** Where the form starts after a post without JavaScript. */
  start?: ContactFormStart;
};

// Prepare the copy, the form's copy and its links in the page's language
const { start } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = getTranslations(locale);
const copy = getContactFormCopy(locale);
const action = `${getRelativeLocaleUrl(locale, ROUTE.CONTACT_SENT)}${actions.contact}#${MESSAGE_ANCHOR}`;
const links = {
  whatsapp: CONTACT.WHATSAPP_HREF,
  privacy: getRelativeLocaleUrl(locale, ROUTE.PRIVACY),
};
---

<section
  id={MESSAGE_ANCHOR}
  aria-labelledby="message-title"
  class="relative isolate -mt-8 overflow-hidden rounded-t-xl bg-bg-alt px-margin pt-12 pb-20 tablet:-mt-10 tablet:px-margin-md tablet:pt-16 tablet:pb-24 desktop:-mt-14 desktop:grid desktop:grid-cols-11 desktop:items-start desktop:gap-x-16 desktop:px-margin-lg desktop:pt-26 desktop:pb-38"
>
  <WovenShade />
  <DecorBead ringed class="top-5 right-24 size-7 desktop:top-12 desktop:right-34" />
  <DotPatch id="contact-message" class="bottom-35 -left-7.5 h-40 w-55" />

  <div class="flex flex-col gap-3 desktop:col-span-4">
    <Opener label={t["contactPage.formOpener"]} />
    <h2 id="message-title" class="type-section-title text-balance text-text-heading">
      {t["contactPage.formTitle"]}
    </h2>
    <p class="type-body text-pretty text-text">{t["contactPage.formIntro"]}</p>
    <p class="mt-1.5 flex gap-2.5 type-body-sm text-text-muted">
      <ShieldCheck class="mt-0.5 size-icon-sm shrink-0" />
      <span>{t["contactPage.formPrivacy"]}</span>
    </p>
  </div>
  <div class="mt-6 rounded-xl bg-surface p-5 shadow-md tablet:p-8 desktop:col-span-7 desktop:mt-0">
    <ContactForm
      client:visible
      locale={locale}
      copy={copy}
      links={links}
      action={action}
      start={start}
    />
  </div>
</section>

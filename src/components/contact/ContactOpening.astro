---
// Dependencies
import { ChevronDown, MessageCircle } from "@lucide/astro";
import { getLocale, getTranslations } from "../../i18n/helpers";
import { CONTACT } from "../../site/constants";
import { CONTACT_DRAWINGS, MESSAGE_ANCHOR } from "./constants";

// Components
import Button from "../ui/Button.astro";
import Opener from "../ui/Opener.astro";
import ContactDrawing from "./ContactDrawing.astro";

/**
 * The {@link Props} type
 * @description The props of the ContactOpening component: Contact on sand, with WhatsApp us and the way down to the form, beside the logo and its welcome bubbles
 */
type Props = Record<string, never>;

// Prepare the copy and the link down to the form
const t = getTranslations(getLocale(Astro.currentLocale));
const messageHref = `#${MESSAGE_ANCHOR}`;
---

<section
  aria-labelledby="contact-title"
  class="relative isolate -mt-16 overflow-hidden bg-bg-alt text-text-heading desktop:-mt-20 desktop:flex desktop:min-h-215 desktop:items-center desktop:pt-20 desktop:pb-14"
>
  <ContactDrawing
    layout={CONTACT_DRAWINGS.PHONE}
    id="contact-phone"
    class="pointer-events-none h-auto w-full tablet:hidden"
  />

  <div class="relative flex flex-col gap-6 px-margin pb-20 tablet:w-130 tablet:px-margin-md tablet:pt-34 tablet:pb-0 desktop:opening-words desktop:gap-8 desktop:pt-0 desktop:pr-0 desktop:pl-margin-lg">
    <div class="flex flex-col gap-3 tablet:gap-4">
      <Opener label={t["contactPage.opener"]} />
      <h1 id="contact-title" class="type-hero text-balance">
        {t["contactPage.heading"]}
      </h1>
    </div>
    <p class="type-body text-pretty text-text desktop:max-w-md desktop:type-lead">
      {t["contactPage.introLanguages"]}
      <br />
      {t["contactPage.intro"]}
    </p>
    <div class="flex flex-col items-center gap-2 tablet:flex-row tablet:gap-8">
      <Button href={CONTACT.WHATSAPP_HREF} block class="tablet:w-auto">
        <MessageCircle />
        {t["contact.whatsapp"]}
      </Button>
      <a
        href={messageHref}
        class="flex min-h-tap touch-manipulation items-center gap-2 type-button text-link underline decoration-2 underline-offset-4 select-none hover:decoration-4"
      >
        {t["contactPage.writeMessage"]}
        <ChevronDown aria-hidden="true" class="size-icon-sm" />
      </a>
    </div>
  </div>

  <div class="mx-auto hidden max-w-208.5 tablet:block desktop:hidden">
    <ContactDrawing
      layout={CONTACT_DRAWINGS.TABLET}
      id="contact-tablet"
      class="pointer-events-none h-auto w-full"
    />
  </div>
  <ContactDrawing
    layout={CONTACT_DRAWINGS.DESKTOP}
    id="contact-desktop"
    class="pointer-events-none opening-aside hidden desktop:block"
  />
</section>

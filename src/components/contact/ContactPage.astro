---
// Dependencies
import { getLocale, getTranslations } from "../../i18n/helpers";

// Components
import SiteLayout from "../../layouts/SiteLayout.astro";
import WovenDefs from "../ui/WovenDefs.astro";
import AddressSection from "./AddressSection.astro";
import ContactOpening from "./ContactOpening.astro";
import MessageSection from "./MessageSection.astro";
import ReachSection from "./ReachSection.astro";

// Types
import type { ContactFormStart } from "./types";

/**
 * The {@link Props} type
 * @description The props of the ContactPage component, the Contact page in the page's language
 */
type Props = {
  /** Where the message form starts after a post without JavaScript. */
  start?: ContactFormStart;
};

// Read where the form starts and the page's title and summary
const { start } = Astro.props;
const t = getTranslations(getLocale(Astro.currentLocale));
---

<SiteLayout title={t["contactPage.title"]} description={t["contactPage.description"]}>
  <WovenDefs />
  <ContactOpening />
  <ReachSection />
  <MessageSection start={start} />
  <AddressSection />
</SiteLayout>

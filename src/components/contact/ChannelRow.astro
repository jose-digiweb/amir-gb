---
// Dependencies
import { ChevronRight } from "@lucide/astro";

/**
 * The {@link Props} type
 * @description The props of the ChannelRow component, one way to reach AMIR-GB as a row a phone visitor taps: its name above its number or address
 */
type Props = {
  /** The channel's name. */
  label: string;
  /** The number or address. */
  value: string;
  /** What tapping opens. */
  href: string;
};

// Read the channel
const { label, value, href } = Astro.props;
---

<a
  href={href}
  class="flex min-h-19 touch-manipulation items-center gap-3 rounded-lg bg-surface px-3.5 py-3 text-text-heading inset-ring inset-ring-border transition-colors duration-fast select-none active:bg-pressed-quiet"
>
  <span class="grid size-11 shrink-0 place-items-center rounded-full bg-bg-alt [&_svg]:size-icon-md">
    <slot name="icon" />
  </span>
  <span class="flex min-w-0 flex-1 flex-col gap-0.5">
    <span class="type-small text-text-muted">{label}</span>
    <span class="type-body-sm font-semibold wrap-anywhere">{value}</span>
  </span>
  <ChevronRight class="size-5 shrink-0 text-text-muted" />
</a>

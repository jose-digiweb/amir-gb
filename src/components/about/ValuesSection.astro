---
// Dependencies
import { getLocale, getTranslations } from "../../i18n/helpers";
import { VALUE_TILES } from "./constants";

// Components
import DecorBead from "../ui/DecorBead.astro";
import Opener from "../ui/Opener.astro";
import WovenShade from "../ui/WovenShade.astro";
import ValueTile from "./ValueTile.astro";

/**
 * The {@link Props} type
 * @description The props of the ValuesSection component: AMIR-GB's four values as tinted tiles with a pictogram
 */
type Props = Record<string, never>;

// Write each value in the page's language
const t = getTranslations(getLocale(Astro.currentLocale));
const tiles = VALUE_TILES.map((tile) => ({
  value: tile.value,
  tint: tile.tint,
  kriol: "kriol" in tile ? t[tile.kriol] : undefined,
  title: t[tile.title],
  text: t[tile.text],
}));
---

<section
  aria-labelledby="values-title"
  class="relative isolate -mt-8 overflow-hidden rounded-t-xl bg-bg-alt px-margin pt-12 pb-16 tablet:-mt-10 tablet:px-margin-md tablet:pt-16 tablet:pb-24 desktop:-mt-14 desktop:px-margin-lg desktop:pt-24 desktop:pb-32"
>
  <WovenShade />
  <DecorBead ringed class="top-6 right-12 size-7 tablet:top-16 tablet:right-34" />
  <div class="mx-auto max-w-page">
    <div class="flex flex-col gap-2 tablet:gap-3">
      <Opener label={t["about.valuesOpener"]} />
      <h2 id="values-title" class="type-section-title text-balance text-text-heading">
        {t["about.valuesTitle"]}
      </h2>
    </div>
    <ul class="mt-6 grid grid-cols-2 gap-3 tablet:mt-10 tablet:gap-5 desktop:grid-cols-4">
      {tiles.map((tile) => (
        <ValueTile
          value={tile.value}
          tint={tile.tint}
          kriol={tile.kriol}
          title={tile.title}
          text={tile.text}
        />
      ))}
    </ul>
  </div>
</section>

---
// Dependencies
import pintiPanel from "../../assets/woven/pinti-panel.svg";

/**
 * The {@link Props} type
 * @description The props of the PortraitPlaceholder component, a woven pinti disc with a person's initials until their photo comes; it looks the same in light and dark, as a photo does
 */
type Props = {
  /** The person's initials. */
  initials: string;
};

// Read the initials
const { initials } = Astro.props;
---

<span
  aria-hidden="true"
  class="relative grid size-22 shrink-0 place-items-center overflow-hidden rounded-full bg-surface-brand tablet:size-30"
>
  <img
    src={pintiPanel.src}
    width={pintiPanel.width}
    height={pintiPanel.height}
    alt=""
    loading="lazy"
    decoding="async"
    class="absolute inset-0 size-full object-cover opacity-50"
  />
  <span class="relative grid size-12 place-items-center rounded-full bg-on-brand type-h4 font-extrabold text-surface-brand tablet:size-16 tablet:type-h2 tablet:font-extrabold">
    {initials}
  </span>
</span>

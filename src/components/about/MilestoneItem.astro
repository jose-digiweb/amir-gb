---
// Dependencies
import { TIMELINE_THREAD } from "./constants";

// Types
import type { MilestonePrecision, MilestoneState } from "../../lib/timeline/types";

/**
 * The {@link Props} type
 * @description The props of the MilestoneItem component, one date of AMIR-GB's first months: a gold dot once it has happened, a gold ring while it is coming up
 */
type Props = {
  /** When it happens, as YYYY-MM-DD, for the script that keeps its state right. */
  date: string;
  /** Whether its day or only its month counts. */
  precision: MilestonePrecision;
  /** Its day and month, or only its month, written in the page's language. */
  when: string;
  /** Its year. */
  year: string;
  /** What happened. */
  text: string;
  /** Done or coming up, on the day the page was built. */
  state: MilestoneState;
  /** Whether a stitched thread runs on to the next milestone. */
  joinsNext: boolean;
  /** The words that mark a milestone still to come. */
  comingUp: string;
};

// Read the milestone
const { date, precision, when, year, text, state, joinsNext, comingUp } = Astro.props;
---

<li
  data-milestone-date={date}
  data-milestone-precision={precision}
  data-state={state}
  class="group relative flex gap-4 pb-6 last:pb-0 desktop:flex-col desktop:gap-3 desktop:pb-0"
>
  {joinsNext ? (
    <>
      <span
        aria-hidden="true"
        class="absolute top-3 bottom-0 left-3 w-1 -translate-x-1/2 desktop:hidden"
      >
        <svg class="size-full overflow-visible">
          <line
            x1="50%"
            y1="0"
            x2="50%"
            y2="100%"
            stroke-width={TIMELINE_THREAD.WIDTH}
            stroke-dasharray={TIMELINE_THREAD.DASH}
            stroke-linecap="round"
            class="stroke-accent"
          ></line>
        </svg>
      </span>
      <span
        aria-hidden="true"
        class="absolute top-3 -right-8 left-3 hidden h-1 -translate-y-1/2 desktop:block"
      >
        <svg class="size-full overflow-visible">
          <line
            x1="0"
            y1="50%"
            x2="100%"
            y2="50%"
            stroke-width={TIMELINE_THREAD.WIDTH}
            stroke-dasharray={TIMELINE_THREAD.DASH}
            stroke-linecap="round"
            class="stroke-accent"
          ></line>
        </svg>
      </span>
    </>
  ) : null}
  <span
    aria-hidden="true"
    class="relative size-6 shrink-0 rounded-full bg-bg ring-4 inset-ring-3 ring-bg inset-ring-accent group-data-[state=done]:bg-accent"
  ></span>
  <span class="flex flex-col gap-1">
    <span class="type-h2 font-extrabold text-text-heading desktop:type-h1 desktop:font-extrabold">
      {when}{" "}
      <span class="desktop:block desktop:type-button-sm desktop:text-text-muted">
        {year}
        <span class="type-button-sm text-text-muted group-data-[state=done]:hidden">
          {" · "}
          {comingUp}
        </span>
      </span>
    </span>
    <span class="type-body text-pretty text-text">{text}</span>
  </span>
</li>

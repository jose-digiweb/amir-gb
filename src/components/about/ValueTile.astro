---
// Dependencies
import { TILE_COLOUR } from "../../lib/content/constants";
import { KRIOL_LANG } from "./constants";

// Components
import ValueIcon from "./ValueIcon.astro";

// Types
import type { TileColour } from "../../lib/content/types";
import type { AboutValue } from "./types";

/**
 * The {@link Props} type
 * @description The props of the ValueTile component, one of AMIR-GB's values as a tinted tile with its pictogram
 */
type Props = {
  /** The value, which picks its pictogram. */
  value: AboutValue;
  /** The tile's tint. */
  tint: TileColour;
  /** Its word in Kriolu, when it has one. */
  kriol?: string;
  /** The value's name. */
  title: string;
  /** One sentence about it. */
  text: string;
};

// Read the tile
const { value, tint, kriol, title, text } = Astro.props;
---

<li
  class:list={[
    "flex flex-col gap-3 rounded-lg p-4 text-text-heading tablet:p-6",
    {
      "bg-tint-gold": tint === TILE_COLOUR.GOLD,
      "bg-tint-forest": tint === TILE_COLOUR.FOREST,
      "bg-tint-brick": tint === TILE_COLOUR.BRICK,
      "bg-tint-navy": tint === TILE_COLOUR.NAVY,
    },
  ]}
>
  <span class="grid size-12 place-items-center rounded-full bg-tile-icon tablet:size-14">
    <ValueIcon value={value} class="size-icon-md tablet:size-icon-lg" />
  </span>
  <span class="flex flex-col gap-1">
    {kriol ? (
      <span lang={KRIOL_LANG} class="type-label text-text-accent">
        {kriol}
      </span>
    ) : null}
    <h3 class="type-h4 text-balance hyphens-auto tablet:type-h3">{title}</h3>
  </span>
  <p class="type-body-sm text-pretty text-text tablet:type-body">{text}</p>
</li>

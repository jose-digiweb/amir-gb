---
// Dependencies
import { getLocale, getTranslations } from "../../i18n/helpers";
import { getBeadArc } from "../../lib/woven/helpers";
import { getValueChips } from "../../site/helpers";
import { WOVEN_DEFS } from "../ui/constants";

// Components
import CentreDisc from "../opening/CentreDisc.astro";
import CentreLogo from "../opening/CentreLogo.astro";
import DrawingLabel from "../opening/DrawingLabel.astro";
import OpeningDrawing from "../opening/OpeningDrawing.astro";
import Sparkles from "../opening/Sparkles.astro";
import StarChip from "../opening/StarChip.astro";
import StitchedThread from "../opening/StitchedThread.astro";

// Types
import type { AboutDrawingLayout } from "./types";

/**
 * The {@link Props} type
 * @description The props of the AboutDrawing component, the opening's drawing: the logo under a stitched arc carrying the motto and an arc of woven beads, with the founding date under it
 */
type Props = {
  /** The screen size's drawing. */
  layout: AboutDrawingLayout;
  /** A prefix for the drawing's own ids, unique on the page. */
  id: string;
  /** Size and placement classes from the caller. */
  class?: string;
};

// Read the drawing, string the arc's beads and name the motto in the page's language
const { layout, id, class: className } = Astro.props;
const t = getTranslations(getLocale(Astro.currentLocale));
const beads = getBeadArc(layout.beads);
const chips = getValueChips(layout.chips, t);
const solidHref = `#${WOVEN_DEFS.SOLID}`;
const ringedHref = `#${WOVEN_DEFS.RINGED}`;
---

<OpeningDrawing frame={layout.frame} dots={layout.dots} id={id} class={className}>
  <StitchedThread
    path={layout.arc.path}
    stitch={layout.arc.stitch}
    frame={layout.frame}
    id={`${id}-arc`}
    order={0}
  />
  {beads.solid.map((bead) => (
    <use href={solidHref} transform={bead.transform} />
  ))}
  {beads.ringed.map((bead) => (
    <use href={ringedHref} transform={bead.transform} />
  ))}
  <Sparkles sparkles={layout.sparkles} />
  <CentreDisc disc={layout.disc}>
    <CentreLogo />
  </CentreDisc>
  {chips.map((chip) => (
    <StarChip x={chip.x} y={chip.y} label={chip.label} />
  ))}
  {layout.founded ? <DrawingLabel at={layout.founded} label={t["about.founded"]} /> : null}
</OpeningDrawing>

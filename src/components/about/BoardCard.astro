---
// Components
import PortraitPlaceholder from "./PortraitPlaceholder.astro";

/**
 * The {@link Props} type
 * @description The props of the BoardCard component, one board member: their portrait placeholder, role, name and tasks
 */
type Props = {
  /** Their full name. */
  name: string;
  /** Their initials, shown until their photo comes. */
  initials: string;
  /** Their role, already in capitals. */
  role: string;
  /** What they look after. */
  tasks: string;
  /** The words that say their photo is still to come. */
  photoToCome: string;
};

// Read the member
const { name, initials, role, tasks, photoToCome } = Astro.props;
---

<li class="flex items-center gap-4 rounded-lg border border-border bg-surface p-4 tablet:flex-col tablet:items-start tablet:gap-3 tablet:p-6 desktop:p-8">
  <PortraitPlaceholder initials={initials} />
  <span class="sr-only type-small text-text-muted tablet:not-sr-only">{photoToCome}</span>
  <span class="flex flex-col gap-1 tablet:contents">
    <span class="type-label text-text-accent">{role}</span>
    <h3 class="type-h4 text-balance text-text-heading tablet:type-h3">{name}</h3>
    <p class="type-body-sm text-pretty text-text tablet:type-body">{tasks}</p>
  </span>
</li>

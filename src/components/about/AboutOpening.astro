---
// Dependencies
import { getLocale, getTranslations } from "../../i18n/helpers";
import { ABOUT_DRAWINGS } from "./constants";

// Components
import MottoChips from "../site/MottoChips.astro";
import Opener from "../ui/Opener.astro";
import AboutDrawing from "./AboutDrawing.astro";

/**
 * The {@link Props} type
 * @description The props of the AboutOpening component: We are AMIR-GB on sand and the story of the name, beside the logo under its arcs with the motto
 */
type Props = Record<string, never>;

// Prepare the page's copy
const t = getTranslations(getLocale(Astro.currentLocale));
---

<section
  aria-labelledby="about-title"
  class="relative isolate -mt-16 overflow-hidden bg-bg-alt text-text-heading desktop:-mt-20 desktop:flex desktop:min-h-220 desktop:items-center desktop:pt-20 desktop:pb-14"
>
  <AboutDrawing
    layout={ABOUT_DRAWINGS.PHONE}
    id="about-phone"
    class="pointer-events-none h-auto w-full tablet:hidden"
  />

  <div class="relative flex flex-col gap-6 px-margin pb-20 tablet:w-130 tablet:px-margin-md tablet:pt-34 tablet:pb-0 desktop:opening-words desktop:gap-8 desktop:pt-0 desktop:pr-0 desktop:pl-margin-lg">
    <div class="flex flex-col gap-3 tablet:gap-4">
      <Opener label={t["about.opener"]} />
      <h1 id="about-title" class="type-hero">
        <span class="block">{t["about.titleStart"]}</span>
        <span class="block">{t["site.name"]}</span>
      </h1>
    </div>
    <p class="type-body text-pretty text-text desktop:max-w-lg desktop:type-lead">
      {t["about.storyStart"]} <b class="font-semibold text-text-heading">{t["about.storyName"]}</b>{" "}
      {t["about.storyEnd"]}
    </p>
    <MottoChips class="tablet:hidden" />
  </div>

  <div class="mx-auto hidden max-w-208.5 tablet:block desktop:hidden">
    <AboutDrawing
      layout={ABOUT_DRAWINGS.TABLET}
      id="about-tablet"
      class="pointer-events-none h-auto w-full"
    />
  </div>
  <AboutDrawing
    layout={ABOUT_DRAWINGS.DESKTOP}
    id="about-desktop"
    class="pointer-events-none opening-aside hidden desktop:block"
  />
</section>

---
// Dependencies
import { getLocale, getTranslations } from "../../i18n/helpers";
import { getTaxStatusText } from "./helpers";

/**
 * The {@link Props} type
 * @description The props of the TaxStatusCard component: AMIR-GB is a vereniging and an SBBI, not an ANBI, so gifts are not tax-deductible for now
 */
type Props = Record<string, never>;

// Write the status in the page's language, with the registration numbers
const locale = getLocale(Astro.currentLocale);
const t = getTranslations(locale);
const text = getTaxStatusText(locale);
---

<div class="flex flex-col gap-2 rounded-lg bg-info-bg p-5">
  <h3 class="type-h4 text-balance text-text-heading">{t["about.taxTitle"]}</h3>
  <p class="type-body-sm text-pretty text-text">{text}</p>
</div>

---
// Dependencies
import { getLocale, getTranslations } from "../../i18n/helpers";
import { getMilestoneViews } from "./helpers";

// Components
import Opener from "../ui/Opener.astro";
import WovenShade from "../ui/WovenShade.astro";
import MilestoneItem from "./MilestoneItem.astro";

/**
 * The {@link Props} type
 * @description The props of the TimelineSection component: AMIR-GB's first months, the dates joined by the gold stitched thread
 */
type Props = Record<string, never>;

// Write the milestones in the page's language, done or coming up on the day the page is built
const locale = getLocale(Astro.currentLocale);
const t = getTranslations(locale);
const milestones = getMilestoneViews(locale, new Date());
---

<section
  aria-labelledby="timeline-title"
  class="relative isolate -mt-8 overflow-hidden rounded-t-xl bg-bg-alt px-margin pt-12 pb-16 tablet:-mt-10 tablet:px-margin-md tablet:pt-16 tablet:pb-24 desktop:-mt-14 desktop:px-margin-lg desktop:pt-24 desktop:pb-32"
>
  <WovenShade />
  <div class="mx-auto max-w-page">
    <div class="flex flex-col gap-2 tablet:gap-3">
      <Opener label={t["about.timelineOpener"]} />
      <h2 id="timeline-title" class="type-section-title text-balance text-text-heading">
        {t["about.timelineTitle"]}
      </h2>
    </div>
    <ol
      role="list"
      class="mt-8 tablet:mt-10 desktop:mt-12 desktop:grid desktop:grid-cols-5 desktop:gap-8"
    >
      {milestones.map((milestone) => (
        <MilestoneItem
          date={milestone.date}
          precision={milestone.precision}
          when={milestone.when}
          year={milestone.year}
          text={milestone.text}
          state={milestone.state}
          joinsNext={milestone.joinsNext}
          comingUp={t["about.comingUp"]}
        />
      ))}
    </ol>
  </div>
</section>

<script>
  // Dependencies
  import { refreshMilestones } from "../../lib/timeline/helpers";

  // A milestone that has passed since the page was built shows as done
  refreshMilestones();
</script>

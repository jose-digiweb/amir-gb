---
// Dependencies
import { getRelativeLocaleUrl } from "astro:i18n";
import { DEFAULT_LOCALE, LOCALES } from "../../i18n/constants";
import { getLocale, getPagePath, getTranslations } from "../../i18n/helpers";
import { SEO } from "../../lib/seo/constants";
import { buildHeadSeo } from "../../lib/seo/helpers";

// Types
import type { PageSeo } from "../../lib/seo/types";

/**
 * The {@link Props} type
 * @description The props of the SeoHead component, a page's title, description, canonical address, language versions and link preview in the document head
 */
type Props = {
  /** Page title, shown in the browser tab, search results and link previews. */
  title: string;
  /** One-sentence summary for search results and link previews. */
  description: string;
  /** What the page sets beyond its title and description; the rest takes the site's defaults. */
  seo?: PageSeo;
};

// Read the page and work out its tags from the site's address and the page's language versions
const { title, description, seo } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = getTranslations(locale);
const site = new URL(Astro.site ?? Astro.url.origin);
const pagePath = getPagePath(Astro.url.pathname);
const localePaths = LOCALES.map((language) => ({
  locale: language,
  path: getRelativeLocaleUrl(language, pagePath),
}));
const head = buildHeadSeo({
  site,
  pathname: Astro.url.pathname,
  locale,
  localePaths,
  defaultLocale: DEFAULT_LOCALE,
  shareImageAlt: t["seo.shareImageAlt"],
  seo,
});
const pageTitle = seo?.title ?? title;
const pageDescription = seo?.description ?? description;
---

<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={head.canonical} />
{head.robots ? <meta name="robots" content={head.robots} /> : null}
{head.alternates.map((alternate) => (
  <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
))}
<meta property="og:site_name" content={SEO.SITE_NAME} />
<meta property="og:type" content={head.ogType} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={head.canonical} />
<meta property="og:locale" content={head.ogLocale} />
{head.ogLocaleAlternates.map((alternate) => (
  <meta property="og:locale:alternate" content={alternate} />
))}
<meta property="og:image" content={head.image.url} />
{head.image.width ? <meta property="og:image:width" content={String(head.image.width)} /> : null}
{head.image.height ? <meta property="og:image:height" content={String(head.image.height)} /> : null}
<meta property="og:image:alt" content={head.image.alt} />
<meta name="twitter:card" content={SEO.TWITTER_CARD} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={head.image.url} />
<meta name="twitter:image:alt" content={head.image.alt} />

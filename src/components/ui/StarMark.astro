---
/**
 * The {@link Props} type
 * @description The props of the StarMark component, the AMIR-GB logo's five-pointed star
 */
type Props = {
  /** Size and colour classes; the star is drawn in the current text colour. */
  class?: string;
};

// Read the classes the caller sizes and colours the star with
const { class: className } = Astro.props;
---

<svg aria-hidden="true" viewBox="0 0 100 100" class:list={["shrink-0 fill-current", className]}>
  <polygon points="50,4.77 61.23,39.32 97.55,39.32 68.16,60.68 79.39,95.23 50,73.87 20.61,95.23 31.84,60.68 2.45,39.32 38.77,39.32"></polygon>
</svg>

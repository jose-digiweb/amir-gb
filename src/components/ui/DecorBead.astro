---
// Dependencies
import { BEAD, LOZENGE } from "../../lib/woven/constants";
import { getWovenPath } from "../../lib/woven/helpers";
import { DECOR_TONE } from "./constants";

// Types
import type { DecorTone } from "./types";

/**
 * The {@link Props} type
 * @description The props of the DecorBead component, one small woven lozenge scattered behind a section's content
 */
type Props = {
  /** The gold bead with its eye, rather than the plain one. */
  ringed?: boolean;
  /** The ground it sits on: a light section, or the navy band. */
  tone?: DecorTone;
  /** Place and size classes from the caller. */
  class?: string;
};

// Read the bead's look and draw its woven parts
const { ringed = false, tone = DECOR_TONE.LIGHT, class: className } = Astro.props;
const isOnBrand = tone === DECOR_TONE.ON_BRAND;
const isSolid = !ringed;
const viewBox = `0 0 ${BEAD.UNITS} ${BEAD.UNITS}`;
const solidPath = getWovenPath(LOZENGE.PIECE_RADIUS, () => true);
const ringPath = getWovenPath(
  LOZENGE.PIECE_RADIUS,
  (distance) => distance >= LOZENGE.PIECE_RING_FROM,
);
const eyePath = getWovenPath(LOZENGE.PIECE_RADIUS, (distance) => distance <= LOZENGE.PIECE_EYE_TO);
---

<svg
  aria-hidden="true"
  viewBox={viewBox}
  class:list={["pointer-events-none absolute -z-10", className]}
>
  {ringed ? (
    <>
      <path
        d={ringPath}
        class:list={{ "fill-accent": !isOnBrand, "fill-on-brand-accent": isOnBrand }}
      ></path>
      <path
        d={eyePath}
        class:list={{ "fill-on-accent-fill": !isOnBrand, "fill-surface-brand": isOnBrand }}
      ></path>
    </>
  ) : null}
  {isSolid ? (
    <path
      d={solidPath}
      class:list={{ "fill-text-heading": !isOnBrand, "fill-motif-band-on-brand": isOnBrand }}
    ></path>
  ) : null}
</svg>

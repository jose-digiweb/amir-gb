---
// Dependencies
import { getNestedLozengePath } from "../../lib/woven/helpers";
import { WOVEN_SHADE_TONE } from "./constants";

// Types
import type { WovenShadeTone } from "./types";

/**
 * The {@link Props} type
 * @description The props of the WovenShade component, the faint woven lozenge in a section's top-right corner
 */
type Props = {
  /** The ground it sits on: a light section, or the navy band. */
  tone?: WovenShadeTone;
};

// Read the ground and draw the nested lozenge
const { tone = WOVEN_SHADE_TONE.LIGHT } = Astro.props;
const isOnBrand = tone === WOVEN_SHADE_TONE.ON_BRAND;
const path = getNestedLozengePath();
---

<span
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 -z-10 overflow-hidden rounded-[inherit]"
>
  <svg
    viewBox="0 0 219 219"
    class:list={[
      "absolute top-0 right-3 size-32 translate-x-1/2 -translate-y-1/2 tablet:right-4 tablet:size-48 desktop:right-8 desktop:size-80",
      { "fill-decor-strong": !isOnBrand, "fill-motif-band-on-brand": isOnBrand },
    ]}
  >
    <path d={path}></path>
  </svg>
</span>

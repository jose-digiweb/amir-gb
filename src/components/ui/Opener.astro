---
// Dependencies
import { OPENER_SEPARATOR, OPENER_TONE } from "./constants";

// Components
import StarMark from "./StarMark.astro";

// Types
import type { OpenerTone } from "./types";

/**
 * The {@link Props} type
 * @description The props of the Opener component, the logo's star and a small label in capitals over a heading
 */
type Props = {
  /** The label, already in capitals. */
  label: string;
  /** The ground it sits on. */
  tone?: OpenerTone;
};

// Read the label and the ground, light by default
const { label, tone = OPENER_TONE.LIGHT } = Astro.props;
const isOnBrand = tone === OPENER_TONE.ON_BRAND;

// Split a label that lists items: lines break between items and balance, and a separator at a line's start is clipped
const items = label.split(OPENER_SEPARATOR);
---

<p
  class:list={[
    "flex items-center gap-2 type-label",
    { "text-text-accent": !isOnBrand, "text-on-brand-accent": isOnBrand },
  ]}
>
  <StarMark class="size-3" />
  <span class="min-w-0 overflow-hidden">
    <span class="-ms-4 block text-balance">
      {items.map((item) => (
        <span class="relative ms-4 inline-block before:absolute before:right-full before:w-4 before:text-center before:content-['·']">
          {item}
        </span>
      ))}
    </span>
  </span>
</p>

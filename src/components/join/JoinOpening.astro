---
// Dependencies
import { HandHelping, IdCard } from "@lucide/astro";
import { getLocale, getTranslations } from "../../i18n/helpers";
import { JOIN_MODE } from "../../lib/join/constants";
import { BUTTON_TONE } from "../ui/constants";
import { JOIN_DRAWINGS } from "./constants";
import { getModeHref } from "./helpers";

// Components
import Button from "../ui/Button.astro";
import Opener from "../ui/Opener.astro";
import JoinDrawing from "./JoinDrawing.astro";

/**
 * The {@link Props} type
 * @description The props of the JoinOpening component: Join in on sand, with Become a member and Volunteer with us, beside the joined hands in a circle of seats with one open
 */
type Props = Record<string, never>;

// Prepare the copy and the links that pick the form's mode
const t = getTranslations(getLocale(Astro.currentLocale));
const memberHref = getModeHref(JOIN_MODE.MEMBER);
const volunteerHref = getModeHref(JOIN_MODE.VOLUNTEER);
---

<section
  aria-labelledby="join-title"
  class="relative isolate -mt-16 overflow-hidden bg-bg-alt text-text-heading desktop:-mt-20 desktop:flex desktop:min-h-215 desktop:items-center desktop:pt-20 desktop:pb-14"
>
  <JoinDrawing
    layout={JOIN_DRAWINGS.PHONE}
    id="join-phone"
    class="pointer-events-none h-auto w-full tablet:hidden"
  />

  <div class="relative flex flex-col gap-6 px-margin pb-20 tablet:w-130 tablet:px-margin-md tablet:pt-34 tablet:pb-0 desktop:opening-words desktop:gap-8 desktop:pt-0 desktop:pr-0 desktop:pl-margin-lg">
    <div class="flex flex-col gap-3 tablet:gap-4">
      <Opener label={t["joinPage.opener"]} />
      <h1 id="join-title" class="type-hero text-balance">
        {t["joinPage.heading"]}
      </h1>
    </div>
    <p class="type-body text-pretty text-text desktop:max-w-md desktop:type-lead">
      {t["joinPage.intro"]}
    </p>
    <div class="flex flex-col gap-2.5 tablet:flex-row">
      <Button href={memberHref} block class="tablet:w-auto">
        <IdCard />
        {t["joinPage.becomeMember"]}
      </Button>
      <Button href={volunteerHref} tone={BUTTON_TONE.OUTLINE} block class="tablet:w-auto">
        <HandHelping />
        {t["joinPage.volunteerWithUs"]}
      </Button>
    </div>
  </div>

  <div class="mx-auto hidden max-w-208.5 tablet:block desktop:hidden">
    <JoinDrawing
      layout={JOIN_DRAWINGS.TABLET}
      id="join-tablet"
      class="pointer-events-none h-auto w-full"
    />
  </div>
  <JoinDrawing
    layout={JOIN_DRAWINGS.DESKTOP}
    id="join-desktop"
    class="pointer-events-none opening-aside hidden desktop:block"
  />
</section>

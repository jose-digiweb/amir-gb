---
// Dependencies
import { BEAD, MEMBERS_LATTICE } from "../../lib/woven/constants";
import { getOpenPlacePath } from "../../lib/woven/helpers";
import { WOVEN_DEFS } from "../ui/constants";

/**
 * The {@link Props} type
 * @description The props of the MembersLattice component, AMIR's members as woven pieces with one open place, and on tablet and desktop a label that says it is yours
 */
type Props = {
  /** The label beside the open place. */
  label: string;
  /** Place and size classes from the caller. */
  class?: string;
};

// Place every piece at its size, and draw the open place once
const { label, class: className } = Astro.props;
const viewBox = `0 0 ${MEMBERS_LATTICE.WIDTH} ${MEMBERS_LATTICE.HEIGHT}`;
const pieceScale = MEMBERS_LATTICE.PIECE_SIZE / BEAD.UNITS;
const toTransform = (point: { x: number; y: number }) =>
  `translate(${point.x} ${point.y}) scale(${pieceScale})`;
const solid = MEMBERS_LATTICE.SOLID.map(toTransform);
const ringed = MEMBERS_LATTICE.RINGED.map(toTransform);
const openTransform = `translate(${MEMBERS_LATTICE.OPEN.x} ${MEMBERS_LATTICE.OPEN.y}) scale(${MEMBERS_LATTICE.OPEN_SIZE / BEAD.UNITS})`;
const openPath = getOpenPlacePath();
---

<div aria-hidden="true" class:list={["pointer-events-none absolute -z-10", className]}>
  <svg viewBox={viewBox} class="block w-full">
    {solid.map((transform) => (
      <use href={`#${WOVEN_DEFS.SOLID}`} transform={transform}></use>
    ))}
    {ringed.map((transform) => (
      <use href={`#${WOVEN_DEFS.RINGED}`} transform={transform}></use>
    ))}
    <path d={openPath} transform={openTransform} class="fill-accent"></path>
  </svg>
  <span class="absolute top-1/2 right-5/6 hidden -translate-y-1/2 type-label whitespace-nowrap text-text-accent tablet:block">
    {label}
  </span>
</div>

---
// Components
import SiteFooter from "../components/site/SiteFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import BaseLayout from "./BaseLayout.astro";

/**
 * The {@link Props} type
 * @description The props of the SiteLayout component: every page with the site's header and footer
 */
type Props = {
  /** Page title, shown in the browser tab and search results. */
  title: string;
  /** One-sentence summary for search results and link previews. */
  description: string;
};

// Pass the page's title and description to the document shell
const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <slot name="head" slot="head" />
  <div class="flex min-h-svh flex-col">
    <SiteHeader />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

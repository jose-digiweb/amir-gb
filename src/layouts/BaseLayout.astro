---
// Dependencies
import { i18n } from "astro:config/server";
import { STALE_PAGE } from "../lib/browser-cache/constants";
import {
  COLOR_SCHEME_AUTO,
  THEME_OVERRIDES,
  THEME_SELECTOR,
  THEME_STORAGE_KEY,
} from "../lib/theme/constants";
import { SITE_CONTENT_ID, SPECULATION_RULES } from "../site/constants";
import "../styles/global.css";

// Components
import { Font } from "astro:assets";
import SeoHead from "../components/seo/SeoHead.astro";

// Types
import type { PageSeo } from "../lib/seo/types";

/**
 * The {@link Props} type
 * @description The props of the BaseLayout component, the document shell every page renders through
 */
type Props = {
  /** Page title, shown in the browser tab and search results. */
  title: string;
  /** One-sentence summary for search results and link previews. */
  description: string;
  /** What the page sets for search and link previews beyond its title and description. */
  seo?: PageSeo;
};

// Read the page's title, description and search settings
const { title, description, seo } = Astro.props;

// Use the language of the URL, or the site's default language where Astro reports none
const lang = Astro.currentLocale ?? i18n?.defaultLocale;

// Write the rules that let Chrome render the next page early
const speculationRules = JSON.stringify(SPECULATION_RULES);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content={COLOR_SCHEME_AUTO} />
    <script
      is:inline
      define:vars={{
        assetPath: STALE_PAGE.ASSET_PATH,
        reloadPrefix: STALE_PAGE.STORAGE_KEY,
        reloadGap: STALE_PAGE.RELOAD_GAP_MS,
        hydrationErrorEvent: STALE_PAGE.HYDRATION_ERROR_EVENT,
        importErrors: STALE_PAGE.IMPORT_ERRORS,
      }}
    >
      // Reload once when this page's own files are gone, as happens to a page kept from before a deploy
      const reloadKey = reloadPrefix + location.pathname;
      const reloadOnce = () => {
        // A page rendered ahead of a tap reloads once it is shown
        if (document.prerendering) {
          document.addEventListener("prerenderingchange", reloadOnce, { once: true });
          return;
        }

        // A reload within the last minute means the file is missing for real, so the page stays
        try {
          if (Date.now() - Number(sessionStorage.getItem(reloadKey)) < reloadGap) {
            return;
          }
          sessionStorage.setItem(reloadKey, String(Date.now()));
        } catch {
          // Blocked storage cannot stop a loop, so the page stays
          return;
        }
        location.reload();
      };

      // A failed import names the missing module in its message
      const isFailedImport = (error) =>
        importErrors.some((text) => String(error?.message ?? error).includes(text));

      // Only a script or a stylesheet holds the page's code
      const sourceOf = (element) => {
        if (element instanceof HTMLScriptElement) {
          return element.src;
        }
        if (element instanceof HTMLLinkElement) {
          return element.href;
        }
        return "";
      };

      // A script or stylesheet of the site that did not load
      window.addEventListener(
        "error",
        (event) => {
          if (sourceOf(event.target).includes(assetPath)) {
            reloadOnce();
          }
        },
        true,
      );

      // Code loaded on demand that did not load, outside an island
      window.addEventListener("unhandledrejection", (event) => {
        if (isFailedImport(event.reason)) {
          reloadOnce();
        }
      });

      // An island whose code did not load, after Astro's own retry
      window.addEventListener(hydrationErrorEvent, (event) => {
        if (isFailedImport(event.detail?.error)) {
          reloadOnce();
        }
      });
    </script>
    <script
      is:inline
      define:vars={{
        storageKey: THEME_STORAGE_KEY,
        overrides: THEME_OVERRIDES,
        metaSelector: THEME_SELECTOR.COLOR_SCHEME_META,
      }}
    >
      // Apply a remembered Light or Dark before the first paint; nothing remembered follows the device
      try {
        const choice = localStorage.getItem(storageKey);
        if (overrides.includes(choice)) {
          document.documentElement.dataset.theme = choice;
          document.querySelector(metaSelector).content = choice;
        }
      } catch {
        // Blocked storage leaves the page on Automatic
      }
    </script>
    <SeoHead title={title} description={description} seo={seo} />
    <script is:inline type="speculationrules" set:html={speculationRules} />
    <link rel="expect" href={`#${SITE_CONTENT_ID}`} blocking="render" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-montserrat" preload={[{ weight: 800 }]} />
    <Font cssVariable="--font-inter" preload={[{ weight: 400 }]} />
    <slot name="head" />
  </head>
  <body class="bg-bg type-body text-text">
    <slot />
  </body>
</html>

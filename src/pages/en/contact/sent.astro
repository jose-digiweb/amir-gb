---
// Dependencies
import { actions } from "astro:actions";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getContactFormStart } from "../../../components/contact/helpers";
import { getLocale } from "../../../i18n/helpers";
import { keepPagePrivate } from "../../../lib/browser-cache/helpers";
import { ROUTE } from "../../../site/constants";

// Components
import ContactPage from "../../../components/contact/ContactPage.astro";

// A message posted without JavaScript comes here, so this page renders per request
export const prerender = false;

// Read what the message came back with; without one, the Contact page is where to go
const result = Astro.getActionResult(actions.contact);
const start = getContactFormStart(result?.data, result?.error);
if (!start) {
  return Astro.redirect(getRelativeLocaleUrl(getLocale(Astro.currentLocale), ROUTE.CONTACT), 303);
}

// One visitor's message is never kept, nor listed by search engines
keepPagePrivate(Astro.response.headers);
---

<ContactPage start={start} />

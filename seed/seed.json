          "type": "image",
          "translatable": false
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "urgent",
          "label": "Show as a strip on the home page",
          "type": "boolean",
          "translatable": false,
          "defaultValue": false
        },
        {
          "slug": "urgent_until",
          "label": "Strip shows until",
          "type": "datetime",
          "translatable": false
        },
        {
          "slug": "strip_text",
          "label": "Strip sentence (about 90 characters)",
          "type": "string",
          "validation": {
            "maxLength": 120
          }
        },
        {
          "slug": "strip_link_label",
          "label": "Strip link label (about 20 characters, empty shows Read more)",
          "type": "string",
          "validation": {
            "maxLength": 30
          }
        }
      ]
    },
    {
      "slug": "events",
      "label": "Events",
      "labelSingular": "Event",
      "supports": ["drafts", "revisions", "search", "seo"],
      "titleField": "title",
      "dateField": "starts_at",
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "summary",
          "label": "Summary",
          "type": "text",
          "searchable": true
        },
        {
          "slug": "image",
          "label": "Image",
          "type": "image",
          "translatable": false
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "starts_at",
          "label": "Starts at",
          "type": "datetime",
          "required": true,
          "translatable": false,
          "indexed": true
        },
        {
          "slug": "ends_at",
          "label": "Ends at",
          "type": "datetime",
          "translatable": false
        },
        {
          "slug": "all_day",
          "label": "All day",
          "type": "boolean",
          "translatable": false,
          "defaultValue": false
        },
        {
          "slug": "place_name",
          "label": "Place name",
          "type": "string",
          "translatable": false
        },
        {
          "slug": "address",
          "label": "Address",
          "type": "string",
          "translatable": false
        },
        {
          "slug": "online_link",
          "label": "Online link",
          "type": "url",
          "translatable": false
        },
        {
          "slug": "registration_link",
          "label": "Registration link",
          "type": "url",
          "translatable": false
        },
        {
          "slug": "type",
          "label": "Type",
          "type": "select",
          "required": true,
          "translatable": false,
          "validation": {
            "options": ["youth", "help", "culture", "community"]
          }
        }
      ]
    },
    {
      "slug": "activities",
      "label": "Weekly activities",
      "labelSingular": "Weekly activity",
      "supports": ["drafts", "revisions"],
      "titleField": "name",

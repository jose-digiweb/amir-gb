  "collections": [
    {
      "slug": "posts",
      "label": "News",
      "labelSingular": "News item",
      "supports": ["drafts", "revisions", "search", "seo"],
      "titleField": "title",
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "type",
          "label": "Type",
          "type": "select",
          "required": true,
          "translatable": false,
          "defaultValue": "news",
          "validation": {
            "options": ["announcement", "news", "story"]
          }
        },
        {
          "slug": "excerpt",
          "label": "Excerpt",
          "type": "text",
          "searchable": true
        },
        {
          "slug": "featured_image",

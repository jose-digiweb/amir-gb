        {
          "slug": "name",
          "label": "Name",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "weekday",
          "label": "Weekday",
          "type": "select",
          "required": true,
          "translatable": false,
          "validation": {
            "options": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          }
        },
        {
          "slug": "start_time",
          "label": "Start time (HH:MM)",
          "type": "string",
          "required": true,
          "translatable": false,
          "validation": {
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          }
        },
        {
          "slug": "end_time",
          "label": "End time (HH:MM)",
          "type": "string",
          "required": true,
          "translatable": false,
          "validation": {
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          }
        },
        {
          "slug": "place",
          "label": "Place",
          "type": "string",
          "translatable": false
        },
        {
          "slug": "tile_colour",
          "label": "Tile colour",
          "type": "select",
          "required": true,
          "translatable": false,
          "defaultValue": "forest",
          "validation": {
            "options": ["gold", "forest", "brick", "navy"]
          }
        }
      ]
    }
  ],

{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "AMIR-GB",
    "description": "News, events and weekly activities of AMIR-GB"
  },
  "settings": {
    "title": "AMIR-GB",
    "timezone": "Europe/Amsterdam"
  },
  "collections": [
    {
      "slug": "events",
      "label": "Agenda",
      "labelSingular": "Activiteit",
      "description": "Bijeenkomsten, feesten, cursussen en andere data. Ze staan op de homepage en op de pagina Activiteiten.",
      "icon": "calendar-dots",
      "sortOrder": 1,
      "admin": {
        "listColumns": ["type", "place_name"]
      },
      "supports": ["drafts", "revisions", "search"],
      "titleField": "title",
      "dateField": "starts_at",
      "fields": [
        {
          "slug": "title",
          "label": "Titel",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "type",
          "label": "Soort (het filter op de pagina Activiteiten)",
          "type": "select",
          "required": true,
          "translatable": false,
          "validation": {
            "options": ["jeugd", "hulp", "cultuur", "gemeenschap"]
          }
        },
        {
          "slug": "starts_at",
          "label": "Begint (datum en tijd)",
          "type": "datetime",
          "required": true,
          "translatable": false,
          "indexed": true
        },
        {
          "slug": "ends_at",
          "label": "Eindigt (leeg laten als er geen vaste eindtijd is)",
          "type": "datetime",
          "translatable": false
        },
        {
          "slug": "place_name",
          "label": "Plek (bijvoorbeeld Huis van de Wijk)",
          "type": "string",
          "translatable": false
        },
        {
          "slug": "address",
          "label": "Adres (straat, nummer en plaats, voor de kaart)",
          "type": "string",
          "translatable": false
        },
        {
          "slug": "online_link",
          "label": "Online link (alleen als je ook online kunt meedoen)",
          "type": "url",
          "translatable": false
        },
        {
          "slug": "registration_link",
          "label": "Aanmeldlink (alleen als mensen zich moeten aanmelden)",
          "type": "url",
          "translatable": false
        },
        {
          "slug": "languages",
          "label": "Talen (welke talen er gesproken worden)",
          "type": "multiSelect",
          "translatable": false,
          "validation": {
            "options": ["nederlands", "engels", "portugees", "kriol"]
          }
        },
        {
          "slug": "image",
          "label": "Foto (mag leeg, dan toont de kaart het geweven patroon)",
          "type": "image",
          "translatable": false
        },
        {
          "slug": "summary",
          "label": "Korte samenvatting (een of twee zinnen, voor overzichten en WhatsApp)",
          "type": "string",
          "searchable": true,
          "validation": {
            "maxLength": 200
          }
        },
        {
          "slug": "content",
          "label": "Over de activiteit",
          "type": "portableText",
          "searchable": true
        }
      ]
    },
    {
      "slug": "posts",
      "label": "Nieuws",
      "labelSingular": "Bericht",
      "description": "Nieuws, aankondigingen van het bestuur en verhalen. Verhalen staan ook in Het leven bij AMIR op de homepage.",
      "icon": "newspaper",
      "sortOrder": 2,
      "admin": {
        "listColumns": ["type"]
      },
      "supports": ["drafts", "revisions", "search"],
      "titleField": "title",
      "fields": [
        {
          "slug": "title",
          "label": "Titel",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "type",
          "label": "Soort (een Verhaal staat ook in Het leven bij AMIR op de homepage)",
          "type": "select",
          "required": true,
          "translatable": false,
          "defaultValue": "nieuws",
          "validation": {
            "options": ["nieuws", "aankondiging", "verhaal"]
          }
        },
        {
          "slug": "featured_image",
          "label": "Foto (nodig voor een Verhaal)",
          "type": "image",
          "translatable": false
        },
        {
          "slug": "excerpt",
          "label": "Korte samenvatting (een of twee zinnen, voor overzichten en WhatsApp)",
          "type": "string",
          "searchable": true,
          "validation": {
            "maxLength": 200
          }
        },
        {
          "slug": "content",
          "label": "Tekst",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "gallery",
          "label": "Foto's van de dag (mag leeg, staan onder de tekst)",
          "type": "repeater",
          "translatable": false,
          "validation": {
            "subFields": [
              {
                "slug": "image",
                "label": "Foto",
                "type": "image",
                "required": true
              }
            ]
          }
        },
        {
          "slug": "board_names",
          "label": "Ondertekend door (voornamen van het bestuur, bijvoorbeeld Fatu, Braima en Joana; alleen voor aankondigingen)",
          "type": "string",
          "translatable": false,
          "validation": {
            "maxLength": 80
          }
        },
        {
          "slug": "event",
          "label": "Over welke activiteit (mag leeg; alleen voor aankondigingen)",
          "type": "reference",
          "translatable": false,
          "validation": {
            "targetCollection": "events"
          }
        },
        {
          "slug": "urgent",
          "label": "Toon een balk bovenaan de homepage (alleen voor aankondigingen)",
          "type": "boolean",
          "translatable": false,
          "defaultValue": false
        },
        {
          "slug": "strip_text",
          "label": "Zin in de balk (ongeveer 90 tekens)",
          "type": "string",
          "validation": {
            "maxLength": 120
          }
        },
        {
          "slug": "strip_link_label",
          "label": "Linktekst in de balk (ongeveer 20 tekens, leeg toont Lees meer)",
          "type": "string",
          "validation": {
            "maxLength": 30
          }
        },
        {
          "slug": "urgent_until",
          "label": "Balk tonen tot (leeg: tot je hem uitzet)",
          "type": "datetime",
          "translatable": false
        }
      ]
    },
    {
      "slug": "activities",
      "label": "Elke week",
      "labelSingular": "Wekelijkse activiteit",
      "description": "Activiteiten die elke week terugkomen, zoals het inloopspreekuur. Ze vullen de homepage aan als er weinig activiteiten in de agenda staan.",
      "icon": "repeat",
      "sortOrder": 3,
      "admin": {
        "listColumns": ["weekday", "start_time"]
      },
      "supports": ["drafts", "revisions"],
      "titleField": "name",
      "fields": [
        {
          "slug": "name",
          "label": "Naam",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "weekday",
          "label": "Dag",
          "type": "select",
          "required": true,
          "translatable": false,
          "validation": {
            "options": [
              "maandag",
              "dinsdag",
              "woensdag",
              "donderdag",
              "vrijdag",
              "zaterdag",
              "zondag"
            ]
          }
        },
        {
          "slug": "start_time",
          "label": "Begint om (bijvoorbeeld 10:00)",
          "type": "string",
          "required": true,
          "translatable": false,
          "validation": {
            "pattern": "^([01]?[0-9]|2[0-3])[:.][0-5][0-9]$"
          }
        },
        {
          "slug": "end_time",
          "label": "Eindigt om (bijvoorbeeld 13:00)",
          "type": "string",
          "required": true,
          "translatable": false,
          "validation": {
            "pattern": "^([01]?[0-9]|2[0-3])[:.][0-5][0-9]$"
          }
        },
        {
          "slug": "place",
          "label": "Plek",
          "type": "string",
          "translatable": false
        }
      ]
    }
  ],
